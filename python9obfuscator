class NewProtectorSignatures:
    """Detection heuristics for all new protector families."""

    @staticmethod
    def identify_all(source: str) -> Dict[str, Tuple[int, List[str]]]:
        return {
            'IronBrew': NewProtectorSignatures._detect_ironbrew(source),
            'XorBrew': NewProtectorSignatures._detect_xorbrew(source),
            'Lumen': NewProtectorSignatures._detect_lumen(source),
            'Synapse Xen': NewProtectorSignatures._detect_synapse(source),
            'Clyde Luau': NewProtectorSignatures._detect_clyde(source),
            'ScriptShield': NewProtectorSignatures._detect_scriptshield(source),
            'Hercules': NewProtectorSignatures._detect_hercules(source),
            'Azkaban': NewProtectorSignatures._detect_azkaban(source),
            'BillChirico': NewProtectorSignatures._detect_billchirico(source),
        }

    @staticmethod
    def _detect_ironbrew(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'Iron[Bb]rew', s): score += 30; ind.append('IronBrew header')
        # IB dispatch: Inst[1], Inst[2], Inst[3] extraction
        ib_dispatch = len(re.findall(r'(Inst|Ins)\[\d+\]', s))
        if ib_dispatch > 8: score += 20; ind.append(f'IB dispatch ({ib_dispatch})')
        # Massive integer initialization array (opcode table)
        ib_arr = re.search(r'local\s+\w+\s*=\s*\{(\d+,){50,}\d+\}', s)
        if ib_arr: score += 15; ind.append('Massive opcode array (50+ ints)')
        # String.byte + table.concat reconstruction
        if re.search(r'table\.concat.*string\.byte', s): score += 10; ind.append('byte concat loop')
        return min(score, 90), ind

    @staticmethod
    def _detect_xorbrew(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'Xor[Bb]rew', s): score += 35; ind.append('XorBrew header')
        # Explicit bit32.bxor decryption loop
        bxor_loops = len(re.findall(r'bit[32]*\.bxor\s*\(', s))
        if bxor_loops > 5: score += 25; ind.append(f'bit32.bxor loops ({bxor_loops})')
        # XOR key table
        if re.search(r'local\s+_?[kK]e?y\s*=\s*\{', s): score += 15; ind.append('XOR key table')
        return min(score, 90), ind

    @staticmethod
    def _detect_lumen(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'[Ll]umen', s): score += 25; ind.append('Lumen header')
        # math.floor(Inst / N) bit extraction
        if re.search(r'math\.floor\s*\(\s*\w+\s*/\s*\d+', s): score += 20; ind.append('Lumen bit extraction')
        # Standardized instruction unpack pattern
        if re.search(r'local\s+[BCD]', s) and re.search(r'Inst\[\d+\]', s): score += 15; ind.append('Lumen inst unpack')
        return min(score, 80), ind

    @staticmethod
    def _detect_synapse(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'(syn|SYNAPSE|__syn)', s, re.I): score += 25; ind.append('Synapse Xen marker')
        # Massive hex/blob string literal
        hex_blob = re.findall(r'"(?:[0-9a-fA-F]{2}){100,}"', s)
        if hex_blob: score += 20; ind.append(f'Massive hex blob ({len(hex_blob[0])} chars)')
        # loadstring with hex conversion
        if re.search(r'load(?:string|)\s*\([^)]*hex', s, re.I): score += 15; ind.append('loadstring(hex)')
        # bit32 heavy usage
        bit32_count = len(re.findall(r'bit32\.', s))
        if bit32_count > 15: score += 10; ind.append(f'bit32 heavy ({bit32_count})')
        # __call metamethod proxying
        if re.search(r'__call\s*=', s): score += 10; ind.append('__call proxy')
        return min(score, 90), ind

    @staticmethod
    def _detect_clyde(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'CLYDE', s): score += 30; ind.append('CLYDE marker')
        # Luau-specific syntax
        if re.search(r'\+=|-=|\*=|/=', s): score += 20; ind.append('Luau compound operators')
        if re.search(r'\bcontinue\b', s): score += 10; ind.append('Luau continue')
        # Hex string definitions \xHH
        hex_strs = len(re.findall(r'\\x[0-9a-fA-F]{2}', s))
        if hex_strs > 20: score += 15; ind.append(f'Hex escapes ({hex_strs})')
        return min(score, 85), ind

    @staticmethod
    def _detect_scriptshield(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'(Script[Ss]hield|SS_|SShield)', s): score += 30; ind.append('ScriptShield marker')
        # Environment proxying
        if re.search(r'getfenv|setfenv', s) and re.search(r'__index', s): score += 20; ind.append('env proxy')
        # Metatable interception
        if re.search(r'setmetatable.*__index', s): score += 15; ind.append('__index metatable')
        # Integrity checks
        if re.search(r'pcall.*check.*end', s, re.DOTALL): score += 10; ind.append('integrity check')
        return min(score, 85), ind

    @staticmethod
    def _detect_hercules(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'[Hh]ercules', s): score += 25; ind.append('Hercules marker')
        # Metamethod-based global interception
        if re.search(r'__index.*__call', s): score += 20; ind.append('__index/__call interception')
        # Guarded function prologues
        if re.search(r'if\s+not\s+\w+\s+then\s+error', s): score += 15; ind.append('guard prologue')
        return min(score, 80), ind

    @staticmethod
    def _detect_azkaban(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'[Aa]zkaban', s): score += 25; ind.append('Azkaban marker')
        # Extreme random char variable names (O0lI patterns)
        o0lI = len(re.findall(r'\b[O0lI]{8,}\b', s))
        if o0lI > 10: score += 20; ind.append(f'O0lI variable names ({o0lI})')
        # Deeply nested if statements (opaque predicates)
        deep_if = len(re.findall(r'if\s+\d+%?\s*==?\s*\d+', s))
        if deep_if > 15: score += 15; ind.append(f'opaque predicates ({deep_if})')
        # Heavy control flow flattening
        if_elseif_chains = len(re.findall(r'elseif\s+', s))
        if if_elseif_chains > 30: score += 10; ind.append(f'heavy elseif chains ({if_elseif_chains})')
        return min(score, 85), ind

    @staticmethod
    def _detect_billchirico(s: str) -> Tuple[int, List[str]]:
        score, ind = 0, []
        if re.search(r'LUA-Obfuscator\.com|BillChirico|Illusion', s, re.I):
            score += 30; ind.append('BillChirico/Illusion header')
        # [Il]+ variable name domination
        il_vars = len(re.findall(r'\b[Il]+\b', s))
        if il_vars > 15: score += 25; ind.append(f'Il-style vars ({il_vars})')
        # Heavy one-liner (minified)
        lines = s.split('\n')
        avg_len = sum(len(l) for l in lines) / max(len(lines), 1)
        if avg_len > 300: score += 15; ind.append(f'heavy minification ({avg_len:.0f} avg chars/line)')
        # Localized string.char only
        if re.search(r'local\s+\w+\s*=\s*string\.char', s) and not re.search(r'while\s+true', s):
            score += 10; ind.append('localized string.char (no VM)')
        return min(score, 85), ind


class ProtectorIdentifier:
    """Combined detector merging existing (MoonSec/Luraph/Moonveil) with new protectors."""

    # --- Existing detectors (unchanged) ---
    LURAPH_V4 = [(r'string\.dump\s*\([^)]*\)\s*:\s*byte\s*\(', 15, 'string.dump CRC'),
        (r'debug\.getinfo\s*\(', 10, 'debug.getinfo probe'),
        (r'(?:getfenv|setfenv)\s*\([^)]*\)', 10, 'env proxy'),
        (r'if\s+not\s+[\w_]+\s+then\s+return\s+end', 12, 'V4 init guard'),
        (r'=\s*0[xX][0-9a-fA-F]{8}', 8, 'hex CRC constant'),
        (r'bit32?\.(?:bxor|band|bor)\s*\([^)]*\)', 12, 'bit32 multi-pass XOR'),
        (r'pcall\s*\(\s*function\s*\(\)[\s\S]*?check[\s\S]*?end\s*\)', 10, 'stack canary'),]
    LURAPH_V3 = [(r'LPH_\d+\s*=', 25, 'LPH_ globals'),
        (r'LPH_\d+\s*=\s*string\.(?:byte|char|sub|len)\b', 20, 'string aliases'),
        (r'table\.concat\s*\([^)]*byte[^)]*\)', 15, 'byte reconstruction'),]
    MOONSEC = [(r'_0x[0-9a-fA-F]{2,8}', 25, 'hex vars'),
        (r'string\.byte\s*\(', 10, 'string.byte'), (r'string\.char\s*\(', 10, 'string.char'),
        (r'local\s+_\w+\s*=\s*string\.', 15, 'local macros'),]
    MOONVEIL = [(r'(?:if\s+.*?==\s*\d+\s*then[\s\S]*?elseif\s+.*?==\s*\d+\s*then){5,}', 30, 'dispatch chain'),
        (r'\[\s*\d+\s*\]\s*=\s*function\s*\(', 20, 'dispatch entries'),
        (r'(\w+)\s*=\s*\1\s*\+\s*\d+', 8, 'state arithmetic'),]

    @classmethod
    def identify(cls, source: str) -> Tuple[str, float, Dict[str, Any]]:
        details = {
            'Luraph V4': {'score': 0, 'indicators': []},
            'Luraph V3': {'score': 0, 'indicators': []},
            'MoonSec': {'score': 0, 'indicators': []},
            'Moonveil': {'score': 0, 'indicators': []},
        }
        if not source or len(source) < 10:
            return ('Unknown', 0.0, details)

        # Run existing detectors
        for dl, patterns in [(details['Luraph V4'], cls.LURAPH_V4),
                              (details['Luraph V3'], cls.LURAPH_V3),
                              (details['MoonSec'], cls.MOONSEC),
                              (details['Moonveil'], cls.MOONVEIL)]:
            for pattern, weight, desc in patterns:
                matches = len(re.findall(pattern, source, re.DOTALL))
                if matches > 0:
                    dl['score'] += weight * min(matches, 3)
                    dl['indicators'].append(f'{desc} (x{matches})')

        # Run new protectors
        new_scores = NewProtectorSignatures.identify_all(source)
        for name, (score, indicators) in new_scores.items():
            if score > 0:
                details[name] = {'score': score, 'indicators': indicators}

        # Compute winner across ALL
        scores = {k: v['score'] for k, v in details.items()}
        max_score = max(scores.values()) if scores else 0

        if max_score >= 20:
            winner = max(scores, key=scores.get)
            confidence = min(round((max_score / 120) * 100, 1), 96.0)
            return (winner, confidence, details)

        # Generic fallback
        esc = len(re.findall(r'\\x[0-9a-fA-F]{2}', source))
        if esc > 20: return ('Generic/Obfuscated', 30.0, details)
        return ('Unknown/Clean', 0.0, details)


