class NameManglerRenamer:
    """Renames obfuscated Illusion/O0/I1 variables to readable names."""

    ILLUSION_PATTERN = re.compile(r'\b([O0lI]{4,})\b')
    
    @staticmethod
    def normalize_tokens(tokens: List[Token]) -> Tuple[List[Token], int]:
        """Scan tokens, rename illusion-style names to loc_1, loc_2, etc."""
        rename_map = {}
        counter = 0
        modified = list(tokens)
        
        for i, token in enumerate(modified):
            if token.type != TokenType.IDENTIFIER:
                continue
            val = token.value
            # Check if it's an illusion pattern (all O0lI chars)
            if NameManglerRenamer.ILLUSION_PATTERN.fullmatch(val):
                if val not in rename_map:
                    counter += 1
                    rename_map[val] = f'loc_{counter}'
                modified[i] = Token(TokenType.IDENTIFIER, rename_map[val],
                                   token.line, token.col, token.raw)
            # Also catch single-letter var names (a, b, c, ... z)
            elif len(val) == 1 and val.isalpha() and val.islower() and val not in LUA_KEYWORDS:
                if val not in rename_map:
                    counter += 1
                    rename_map[val] = f'var_{counter}'
                modified[i] = Token(TokenType.IDENTIFIER, rename_map[val],
                                   token.line, token.col, token.raw)
        
        return modified, counter

    @staticmethod
    def tokens_to_source(tokens: List[Token]) -> str:
        """Reconstruct source from tokens."""
        parts = []
        for token in tokens:
            if token.type == TokenType.NEWLINE:
                parts.append('\n')
            elif token.type == TokenType.WHITESPACE:
                parts.append(' ')
            else:
                parts.append(token.value)
        return ''.join(parts)


class ControlFlowUnroller:
    """Deep-dive dispatch loop unroller with transition graph + name normalization."""

    @staticmethod
    def unroll(result: PipelineResult) -> PipelineResult:
        try:
            src = result.source

            # --- Pre-pass: Rename illusion/mangled variables ---
            if result.protector in ('Azkaban', 'BillChirico', 'Generic/Obfuscated', 'Unknown/Clean'):
                try:
                    tokenizer = LuaTokenizer(src)
                    tokens = tokenizer.get_tokens(skip_ws=False)
                    renamed_tokens, rename_count = NameManglerRenamer.normalize_tokens(tokens)
                    result.renamed_vars_count = rename_count
                    if rename_count > 0:
                        src = NameManglerRenamer.tokens_to_source(renamed_tokens)
                        result.log('L4-Renamer', DiagnosticSeverity.INFO,
                                   f'Renamed {rename_count} obfuscated variables')
                except Exception as e:
                    result.log('L4-Renamer', DiagnosticSeverity.WARN,
                               f'Name normalization failed: {e}')

            # Pass 1: Strip dead code
            src, removed = ControlFlowUnroller._strip_dead_code(src)
            result.dead_code_bytes += removed

            # Pass 2: Unroll dispatch loops
            src, unrolled, transitions = ControlFlowUnroller._unroll_dispatch_loops(src)
            result.loops_unrolled += unrolled
            result.state_transitions.extend(transitions)

            # Pass 3: Inline proxies
            src = ControlFlowUnroller._inline_proxies(src)

            # Pass 4: Cleanup
            src = ControlFlowUnroller._cleanup_nested_blocks(src)

            result.source = src

        except Exception as e:
            tb = traceback.format_exc()
            result.log('L4-Unroller', DiagnosticSeverity.ERROR,
                       f'Unrolling failed: {e}', tb=tb)

        return result

    @staticmethod
    def _strip_dead_code(src: str) -> Tuple[str, int]:
        removed = 0; m = src
        # Empty comments
        orig = len(m); m = re.sub(r'--\[\[\s*\]\]', '', m); m = re.sub(r'--\[\[\s*--\s*\]\]', '', m)
        removed += orig - len(m)
        # if false then ... end
        orig = len(m); m = re.sub(r'if\s+false\s+then\s*(?:(?!\bend\b).)*\bend\b', '', m, flags=re.DOTALL)
        removed += orig - len(m)
        # Static conditions
        def eval_if(match):
            body = match.group(1)
            cm = re.match(r'if\s+(\d+)\s*==\s*(\d+)\s*then', match.group(0))
            if cm:
                a, b = int(cm.group(1)), int(cm.group(2))
                return body.strip() if a == b else ''
            return match.group(0)
        m = re.sub(r'if\s+\d+\s*==\s*\d+\s*then\s*([\s\S]*?)\bend\b', eval_if, m)
        # while false
        orig = len(m); m = re.sub(r'while\s+false\s+do[\s\S]*?\bend\b', '', m)
        removed += orig - len(m)
        # Garbage table injections
        orig = len(m); m = re.sub(r"""\[\s*['"][\w]+['"]\s*\]\s*=\s*\{[^}]*\{[^}]*\}[^}]*\},?""", '', m)
        removed += orig - len(m)
        return m, removed

    @staticmethod
    def _unroll_dispatch_loops(src: str) -> Tuple[str, int, List[Tuple[int, int]]]:
        unrolled = 0; all_trans = []

        def unroll_match(match):
            nonlocal unrolled, all_trans
            body = match.group(1)
            blocks = ControlFlowUnroller._extract_state_blocks(body)
            if not blocks or len(blocks) < 3:
                return match.group(0)
            trans, svar = ControlFlowUnroller._build_transition_graph(body, blocks)
            if not trans: return match.group(0)
            all_trans.extend(trans)
            # Find initial state
            init_m = re.search(re.escape(svar) + r'\s*=\s*(\d+)', src[:match.start()])
            init_state = int(init_m.group(1)) if init_m else min(b['state'] for b in blocks)
            # Traverse graph
            sorted_b = ControlFlowUnroller._traverse_graph(blocks, trans, init_state)
            if not sorted_b: return match.group(0)
            unrolled += 1
            parts = []
            for i, b in enumerate(sorted_b):
                cc = re.sub(re.escape(b.get('var', svar)) + r'\s*=\s*[^;\n]+[;\n]?', '', b['code'])
                cc = re.sub(r'\bbreak\b', '', cc)
                parts.append(f"-- [[ State {b['state']} ({i+1}/{len(sorted_b)}) ]]\n{cc.strip()}")
            return '\n'.join(parts)

        m = re.sub(r'while\s+(?:true|1)\s+do\s*([\s\S]*?)\bend\b', unroll_match, src)
        return m, unrolled, all_trans

    @staticmethod
    def _extract_state_blocks(body: str) -> List[Dict]:
        blocks = []
        for m in re.finditer(r'(?:if|elseif)\s+(\w+)\s*==\s*(\d+)\s*then\s*([\s\S]*?)(?=elseif|\bend\b)', body):
            blocks.append({'state': int(m.group(2)), 'var': m.group(1), 'code': m.group(3).strip(), 'type': 'static'})
        if not blocks:
            for m in re.finditer(r'(\w+)\s*=\s*(\d+)\s*[\s\S]*?(?=\1\s*=\s*\d+|$)', body):
                bm = re.search(r'(?:do|then)\s*([\s\S]*?)\bend\b', body[m.start():])
                if bm:
                    blocks.append({'state': int(m.group(2)), 'var': m.group(1), 'code': bm.group(1).strip(), 'type': 'dynamic'})
        seen = set(); unique = []
        for b in blocks:
            if b['state'] not in seen: seen.add(b['state']); unique.append(b)
        return sorted(unique, key=lambda b: b['state'])

    @staticmethod
    def _build_transition_graph(body: str, blocks: List[Dict]) -> Tuple[List[Tuple[int,int]], str]:
        trans = []; sv = blocks[0]['var'] if blocks else ''
        for b in blocks:
            for am in re.finditer(re.escape(sv) + r'\s*=\s*(\d+)', b['code']):
                trans.append((b['state'], int(am.group(1))))
            for cm in re.finditer(re.escape(sv) + r'\s*=\s*(?:\w+\s*\+\s*(\d+)|\d+\s*\+\s*\w+)', b['code']):
                if cm.group(1): trans.append((b['state'], b['state'] + int(cm.group(1))))
        if not trans and len(blocks) > 1:
            for i in range(len(blocks)-1): trans.append((blocks[i]['state'], blocks[i+1]['state']))
            trans.append((blocks[-1]['state'], blocks[0]['state']))
        return trans, sv

    @staticmethod
    def _traverse_graph(blocks, transitions, initial_state):
        bmap = {b['state']: b for b in blocks}
        adj = defaultdict(list)
        for s, d in transitions: adj[s].append(d)
        visited = set(); order = []
        def dfs(state, depth=0):
            if depth > 50: return
            if state in visited: return
            if state not in bmap: return
            visited.add(state)
            if state in bmap: order.append(bmap[state])
            for ns in adj.get(state, []): dfs(ns, depth+1)
        dfs(initial_state)
        return order or sorted(blocks, key=lambda b: b['state'])

    @staticmethod
    def _inline_proxies(src: str) -> str:
        m = src
        # local f = function(x) return x end
        for mt in re.finditer(r'local\s+(\w+)\s*=\s*function\s*\((\w+)\)\s*return\s*\2\s*end\s*', m):
            fn, _ = mt.group(1), mt.group(2)
            m = re.sub(r'local\s+' + re.escape(fn) + r'\s*=\s*function\s*\(\w+\)\s*return\s*\w+\s*end\s*', '', m, count=1)
            m = re.sub(re.escape(fn) + r'\s*\(\s*([^)]+)\s*\)', r'\1', m)
        return m

    @staticmethod
    def _cleanup_nested_blocks(src: str) -> str:
        m = src
        m = re.sub(r'do\s*\bend\b', '', m)
        m = re.sub(r'then\s*\bend\b', '', m)
        m = re.sub(r'\n{3,}', '\n\n', m)
        return m


# ======================================================================
# LAYER 5: PRODUCTION BEAUTIFIER
# ======================================================================

class LuaBeautifier:
    SCOPE_UP = {'then', 'do', 'else', 'elseif', 'function', 'repeat'}
    SCOPE_DOWN = {'end', 'else', 'elseif', 'until'}
    
    @classmethod
    def beautify(cls, source: str) -> str:
        try:
            tok = LuaTokenizer(source)
            tokens = tok.get_tokens(skip_ws=False)
            return cls._format_tokens(tokens)
        except Exception:
            return cls._basic(source)

    @classmethod
    def _format_tokens(cls, tokens: List[Token]) -> str:
        lines = []; cur = []; indent = 0; line_start = True; last_type = None
        for i, t in enumerate(tokens):
            if t.type == TokenType.KEYWORD and t.value in cls.SCOPE_DOWN and line_start:
                indent = max(0, indent - 1)
            if t.type == TokenType.NEWLINE:
                if cur:
                    txt = ''.join(cur).strip()
                    if txt: lines.append('  ' * indent + txt)
                    cur = []; line_start = True
                continue
            if t.type == TokenType.WHITESPACE: continue
            sp = ''
            if line_start: sp = ''; line_start = False
            else:
                if t.value in ('=', '+', '-', '*', '/', '%', '^', '..', '==', '~=', '<=', '>=', '<', '>', '+='):
                    sp = ' '
                elif t.value == ',': sp = ', '; t = Token(t.type, '', t.line, t.col, t.raw)
                else: sp = ' '
            cur.append(sp + t.value)
            last_type = t.type
            if t.type == TokenType.KEYWORD and t.value in cls.SCOPE_UP and not line_start:
                nr = cls._next_real(tokens, i+1)
                if nr and nr.value != 'end': indent += 1
        if cur:
            txt = ''.join(cur).strip()
            if txt: lines.append('  ' * indent + txt)
        return '\n'.join(lines)

    @staticmethod
    def _next_real(tokens, start):
        for i in range(start, min(start+10, len(tokens))):
            if tokens[i].type not in (TokenType.WHITESPACE, TokenType.COMMENT, TokenType.BLOCK_COMMENT, TokenType.NEWLINE):
                return tokens[i]
        return None

    @staticmethod
    def _basic(source: str) -> str:
        s = source.replace('\r\n', '\n')
        s = re.sub(r'\n{3,}', '\n\n', s)
        s = re.sub(r'\s*=\s*', ' = ', s); s = re.sub(r'\s*\+\s*', ' + ', s)
        s = re.sub(r'\s*,\s*', ', ', s)
        lines = s.split('\n'); indent = 0; result = []
        for line in lines:
            st = line.strip()
            if not st: result.append(''); continue
            if any(st.startswith(k) for k in ('end', 'else', 'elseif', 'until')):
                indent = max(0, indent - 1)
            result.append('  ' * indent + st)
            if any(st.endswith(k) for k in ('then', 'do')) or st == 'else' or st.startswith('function') or st == 'repeat':
                indent += 1
        return '\n'.join(result)


# ======================================================================
# MAIN ENGINE ORCHESTRATOR
# ======================================================================

class LuaDeobfuscationEngine:
    @classmethod
    def run(cls, raw_source: str) -> str:
        result = PipelineResult(source=raw_source)
        result.log('Orchestrator', DiagnosticSeverity.INFO,
                   f'Engine v2.0 started. Input: {len(raw_source):,} bytes')

        # L1: Tokenize
        result.log('L1-Tokenizer', DiagnosticSeverity.INFO, 'Tokenizing...')
        try:
            tok = LuaTokenizer(raw_source)
            result.tokens = tok.get_tokens()
            analyzer = ScopeAnalyzer(result.tokens)
            result.scope_table = analyzer.analyze()
            result.log('L1-Tokenizer', DiagnosticSeverity.INFO,
                       f'{len(result.tokens)} tokens, {len(result.scope_table)} vars tracked')
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L1-Tokenizer', DiagnosticSeverity.ERROR, f'Tokenize fail: {e}', tb=tb)

        # L2: Identify
        result.log('L2-Identifier', DiagnosticSeverity.INFO, 'Identifying protector...')
        try:
            protector, confidence, details = ProtectorIdentifier.identify(result.source)
            result.protector = protector; result.confidence = confidence
            for family, info in details.items():
                if info.get('score', 0) > 0:
                    for ind in info.get('indicators', [])[:3]:
                        result.log('L2-Identifier', DiagnosticSeverity.INFO, f'  [{family}] {ind}')
            result.log('L2-Identifier', DiagnosticSeverity.INFO,
                       f'Detected: {protector} ({confidence:.1f}%)')
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L2-Identifier', DiagnosticSeverity.ERROR, f'ID fail: {e}', tb=tb)

        # L3: Deserialize
        result.log('L3-Deserializer', DiagnosticSeverity.INFO, 'Deserializing constants...')
        result = ConstantDeserializer.deserialize(result)
        result.log('L3-Deserializer', DiagnosticSeverity.INFO,
                   f'Decrypted {result.constants_decrypted} constants')

        # L4: Unroll
        result.log('L4-Unroller', DiagnosticSeverity.INFO, 'Unrolling control flow...')
        result = ControlFlowUnroller.unroll(result)
        result.log('L4-Unroller', DiagnosticSeverity.INFO,
                   f'Removed {result.dead_code_bytes:,} dead bytes, '
                   f'unrolled {result.loops_unrolled} loops, '
                   f'renamed {result.renamed_vars_count} vars')

        # L5: Beautify
        result.log('L5-Beautifier', DiagnosticSeverity.INFO, 'Beautifying...')
        try:
            result.source = LuaBeautifier.beautify(result.source)
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L5-Beautifier', DiagnosticSeverity.WARN, f'Beautify fallback: {e}', tb=tb)
            result.source = LuaBeautifier._basic(result.source)

        result.log('Orchestrator', DiagnosticSeverity.INFO, 'Pipeline complete')
        return result.to_final_output()


# ======================================================================
# CLI ENTRY POINT
# ======================================================================

def main():
    try:
        raw = sys.stdin.read()
        output = LuaDeobfuscationEngine.run(raw)
        print(output)
    except KeyboardInterrupt:
        sys.exit(1)
    except Exception as e:
        print(f"-- [[ Fatal: {e} ]] --", file=sys.stderr)
        traceback.print_exc(file=sys.stderr)
        sys.exit(1)

if __name__ == '__main__':
    main()
