class NewDeserializer:
    """Deserialization logic for all new protector families."""

    @staticmethod
    def apply(result: PipelineResult) -> PipelineResult:
        protector = result.protector
        if protector in ('IronBrew', 'XorBrew'):
            return NewDeserializer._deserialize_ironbrew_family(result, use_xor=('Xor' in protector))
        elif protector == 'Lumen':
            return NewDeserializer._deserialize_lumen(result)
        elif protector in ('Synapse Xen', 'Clyde Luau'):
            return NewDeserializer._deserialize_synapse_clyde(result)
        elif protector in ('ScriptShield', 'Hercules'):
            return NewDeserializer._deserialize_shield_hercules(result)
        elif protector in ('Azkaban', 'BillChirico', 'Generic/Obfuscated', 'Unknown/Clean'):
            return NewDeserializer._deserialize_web_minifier(result)
        return result

    @staticmethod
    def _try_xor(bytes_list: List[int], key: int = None) -> Optional[str]:
        if not bytes_list or len(bytes_list) < 2: return None
        # Try raw ASCII first
        try:
            d = bytes(bytes_list).decode('latin-1')
            if d.isprintable() and len(d) > 2 and any(c.isalpha() for c in d): return d
        except: pass
        # XOR strategies
        for k in ([key] if key is not None else range(256)):
            try:
                d = bytes(b ^ k for b in bytes_list).decode('latin-1')
                if re.match(r'^[\x20-\x7E]+$', d) and len(d) > 2 and any(c.isalpha() for c in d): return d
            except: continue
        # Position XOR
        for base in [0, 1, 5, 13, 42, 128]:
            try:
                d = bytes(b ^ ((base + i) % 256) for i, b in enumerate(bytes_list)).decode('latin-1')
                if re.match(r'^[\x20-\x7E]+$', d) and len(d) > 2 and any(c.isalpha() for c in d): return d
            except: continue
        return None

    @staticmethod
    def _extract_bytes(src: str, start: int) -> Tuple[List[int], int]:
        if start >= len(src) or src[start] != '{': return [], start
        bl, depth, i, num = [], 1, start + 1, ''
        while i < len(src) and depth > 0:
            ch = src[i]
            if ch == '{': depth += 1
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    if num.strip():
                        try: bl.append(int(eval(num.strip())) & 0xFF)
                        except: pass
                    break
                if num.strip():
                    try: bl.append(int(eval(num.strip())) & 0xFF)
                    except: pass; num = ''
            elif ch == ',':
                if num.strip():
                    try: bl.append(int(eval(num.strip())) & 0xFF)
                    except: pass; num = ''
            elif ch.isdigit() or ch in 'xXabcdefABCDEF+-*/%': num += ch
            elif ch in ' \t': pass
            else: num += ch
            i += 1
        return bl, i + 1

    @staticmethod
    def _deserialize_ironbrew_family(result: PipelineResult, use_xor: bool = False) -> PipelineResult:
        src = result.source
        constants, restored = {}, 0
        
        # Pattern 1: Massive opcode integer array
        for match in re.finditer(r'local\s+(\w+)\s*=\s*\{(\d+(?:\s*,\s*\d+)+)\}', src):
            nums = [int(n) & 0xFF for n in re.findall(r'\d+', match.group(2)) if 0 <= int(n) <= 255]
            if len(nums) > 10:
                # IB uses arithmetic: (byte - offset) % 256
                if not use_xor:
                    for offset in range(256):
                        decoded = bytes((b - offset) % 256 for b in nums)
                        try:
                            ds = decoded.decode('latin-1')
                            if ds.isprintable() and len(ds) > 5 and any(c.isalpha() for c in ds):
                                constants[f'ib_{restored}'] = ds; restored += 1; break
                        except: continue
                else:
                    dec = NewDeserializer._try_xor(nums)
                    if dec: constants[f'xr_{restored}'] = dec; restored += 1

        # Pattern 2: XorBrew bit32.bxor decryption
        if use_xor:
            for match in re.finditer(r'bit[32]*\.bxor\s*\(\s*(\w+)\s*,\s*(\d+)\s*\)', src):
                vname, k = match.group(1), int(match.group(2))
                if vname in result.scope_table:
                    for entry in result.scope_table[vname]:
                        if isinstance(entry['value'], int):
                            dec_val = entry['value'] ^ k
                            if 32 <= dec_val <= 126:
                                constants[f'bxor_{restored}'] = chr(dec_val); restored += 1

        # Pattern 3: string.byte concat reconstruction
        for match in re.finditer(r'string\.char\s*\(\s*(\d+(?:\s*,\s*\d+)+)\s*\)', src):
            nums = [int(n.strip()) & 0xFF for n in match.group(1).split(',') if 32 <= int(n.strip()) <= 126]
            if len(nums) > 2:
                try:
                    constants[f'str_{restored}'] = bytes(nums).decode('latin-1'); restored += 1
                except: continue

        result.constants_decrypted = restored
        result.constant_map = constants
        return result

    @staticmethod
    def _deserialize_lumen(result: PipelineResult) -> PipelineResult:
        src = result.source
        constants, restored = {}, 0
        # Lumen stores strings as byte arrays with bit extraction
        for match in re.finditer(r'local\s+\w+\s*=\s*\{(\d+(?:\s*,\s*\d+)+)\}', src):
            nums = [int(n) & 0xFF for n in re.findall(r'\d+', match.group(1)) if 0 <= int(n) <= 255]
            if len(nums) > 5:
                # Try direct ASCII, then XOR
                dec = NewDeserializer._try_xor(nums)
                if dec: constants[f'lm_{restored}'] = dec; restored += 1
        # Extract from math.floor patterns
        for match in re.finditer(r'math\.floor\s*\(\s*(\w+)\s*/\s*(\d+)\)', src):
            vname, divisor = match.group(1), int(match.group(2))
            if vname in result.scope_table:
                for entry in result.scope_table[vname]:
                    if isinstance(entry['value'], (int, float)):
                        char_code = int(float(entry['value']) / divisor)
                        if 32 <= char_code <= 126:
                            constants[f'lm_floor_{restored}'] = chr(char_code); restored += 1
        result.constants_decrypted = restored
        result.constant_map = constants
        return result

    @staticmethod
    def _deserialize_synapse_clyde(result: PipelineResult) -> PipelineResult:
        src = result.source
        constants, restored = {}, 0
        
        # Pattern 1: Hex blob extraction (Synapse)
        for match in re.finditer(r'"((?:[0-9a-fA-F]{2}){20,})"', src):
            hex_str = match.group(1)
            try:
                raw_bytes = bytes.fromhex(hex_str)
                # Try to decode as ASCII
                decoded = raw_bytes.decode('latin-1', errors='ignore')
                if any(c.isalpha() for c in decoded):
                    constants[f'hex_{restored}'] = decoded[:200]; restored += 1
            except: continue
        
        # Pattern 2: Extract \x hex escapes (Clyde Luau)
        for match in re.finditer(r'"((?:\\x[0-9a-fA-F]{2})+)"', src):
            hex_seq = match.group(1)
            try:
                bytes_list = [int(h, 16) for h in re.findall(r'x([0-9a-fA-F]{2})', hex_seq)]
                if len(bytes_list) > 2:
                    decoded = bytes(bytes_list).decode('latin-1', errors='ignore')
                    constants[f'xes_{restored}'] = decoded; restored += 1
            except: continue
        
        # Pattern 3: bit32.bxor with constants
        for match in re.finditer(r'bit32\.bxor\s*\(\s*(\d+)\s*,\s*(\d+)\s*\)', src):
            a, b = int(match.group(1)), int(match.group(2))
            result_int = a ^ b
            if 32 <= result_int <= 126:
                constants[f'bx_{restored}'] = chr(result_int); restored += 1
        
        # Pattern 4: Loadstring hex pattern
        ls_match = re.search(r'load(?:string)?\s*\(\s*["\']([^"\']+)["\']', src)
        if ls_match:
            constants['loadstring_arg'] = ls_match.group(1)[:200]; restored += 1

        result.constants_decrypted = restored
        result.constant_map = constants
        return result

    @staticmethod
    def _deserialize_shield_hercules(result: PipelineResult) -> PipelineResult:
        src = result.source
        constants, restored = {}, 0
        
        # Pattern 1: Resolve environment proxy tables
        for match in re.finditer(r'setmetatable\s*\(\s*\{([^}]*)\}\s*,\s*\{', src):
            content = match.group(1)
            # Extract key-value pairs that look like global mappings
            for kv in re.finditer(r'\[\s*["\'](\w+)["\']\s*\]\s*=\s*["\'](\w+)["\']', content):
                constants[f'env_{kv.group(1)}'] = kv.group(2); restored += 1
        
        # Pattern 2: Extract string constants from __index tables
        for match in re.finditer(r'__index\s*=\s*\{([^}]+)\}', src):
            content = match.group(1)
            for kv in re.finditer(r'(\w+)\s*=\s*["\']([^"\']+)["\']', content):
                constants[f'idx_{kv.group(1)}'] = kv.group(2); restored += 1
        
        # Pattern 3: Standard string.char arrays
        for match in re.finditer(r'string\.char\s*\(\s*(\d+(?:\s*,\s*\d+){4,})\s*\)', src):
            nums = [int(n.strip()) & 0xFF for n in match.group(1).split(',') if 32 <= int(n.strip()) <= 126]
            if len(nums) > 3:
                try:
                    constants[f'sh_{restored}'] = bytes(nums).decode('latin-1'); restored += 1
                except: continue

        result.constants_decrypted = restored
        result.constant_map = constants
        return result

    @staticmethod
    def _deserialize_web_minifier(result: PipelineResult) -> PipelineResult:
        src = result.source
        constants, restored = {}, 0
        
        # Pattern 1: string.char with localized variable
        for match in re.finditer(r'(?:_c|s_char|ch|_ch)?\s*\(\s*(\d+(?:\s*,\s*\d+)+)\s*\)', src):
            nums = [int(n.strip()) for n in re.match(r'\d+(?:\s*,\s*\d+)+', match.group(1)).group(0).split(',')
                   if 32 <= int(n.strip()) <= 126]
            if len(nums) > 2:
                try:
                    constants[f'min_{restored}'] = bytes(nums).decode('latin-1'); restored += 1
                except: continue

        # Pattern 2: Inline byte arrays
        for match in re.finditer(r'\{\s*(\d{2,3}\s*,\s*){3,}\d{2,3}\s*\}', src):
            nums = [int(n) & 0xFF for n in re.findall(r'\d+', match.group(0)) if 32 <= int(n) <= 126]
            if len(nums) > 3:
                try:
                    decoded = bytes(nums).decode('latin-1')
                    if any(c.isalpha() for c in decoded):
                        constants[f'arr_{restored}'] = decoded; restored += 1
                except: continue
        
        # Pattern 3: Name-mangled string references (short var names)
        for match in re.finditer(r'(\b[a-z]+\b)\s*\(\s*["\']([^"\']+)["\']', src):
            var_name = match.group(1)
            if len(var_name) <= 3 and var_name.islower():  # Short name = mangled
                constants[f'nl_{var_name}_{restored}'] = match.group(2); restored += 1

        result.constants_decrypted = restored
        result.constant_map = constants
        return result


class ConstantDeserializer:
    """Main deserializer that routes to existing and new handlers."""

    @staticmethod
    def deserialize(result: PipelineResult) -> PipelineResult:
        try:
            if not result.tokens:
                tok = LuaTokenizer(result.source)
                result.tokens = tok.get_tokens()
            analyzer = ScopeAnalyzer(result.tokens)
            result.scope_table = analyzer.analyze()

            # Route based on protector
            p = result.protector
            if 'Luraph' in p:
                result = ConstantDeserializer._deserialize_luraph(result)
            elif 'MoonSec' in p:
                result = ConstantDeserializer._deserialize_moonsec(result)
            elif 'Moonveil' in p:
                result = ConstantDeserializer._deserialize_moonveil(result)
            else:
                # Route to new deserializers
                result = NewDeserializer.apply(result)
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L3-Deserializer', DiagnosticSeverity.ERROR,
                       f'Deserialization: {e}', tb=tb)
        return result

    @staticmethod
    def _deserialize_luraph(result: PipelineResult) -> PipelineResult:
        src = result.source; constants, restored = {}, 0
        for match in re.finditer(r'local\s+(LPH_\d+)\s*=\s*\{', src):
            vn = match.group(1)
            bl, _ = NewDeserializer._extract_bytes(src, match.end() - 1)
            if len(bl) > 3:
                dec = NewDeserializer._try_xor(bl)
                if dec: constants[vn] = dec; restored += 1
                    # Log
        for match in re.finditer(r'table\.concat\s*\(\s*\{([^}]+)\}\s*\)', src):
            nums = [int(n) & 0xFF for n in re.findall(r'\d+', match.group(1)) if n.strip()]
            if len(nums) > 3:
                dec = NewDeserializer._try_xor(nums)
                if dec: constants[f'concat_{restored}'] = dec; restored += 1
        mod = src
        for vn, dec in constants.items():
            if vn.startswith('LPH_'): mod = mod.replace(vn, f'"{dec}"')
        result.source = mod; result.constants_decrypted = restored; result.constant_map = constants
        return result

    @staticmethod
    def _deserialize_moonsec(result: PipelineResult) -> PipelineResult:
        src = result.source; constants, restored = {}, 0
        hex_vars = {}
        for m in re.finditer(r'_0x([0-9a-fA-F]+)\s*=\s*(\d+)', src):
            hex_vars[f'_0x{m.group(1)}'] = int(m.group(2))
        for match in re.finditer(r'\{([^}]*string\.byte[^}]*)\}', src):
            nums = [int(n) & 0xFF for n in re.findall(r'\d+', match.group(1)) if n.strip()]
            if len(nums) > 3:
                for key in list(hex_vars.values())[:5] + [0, 1, 2, 255]:
                    tb = [b ^ ((key + i) % 256) for i, b in enumerate(nums)]
                    try:
                        d = bytes(tb).decode('latin-1')
                        if re.match(r'^[\x20-\x7E]+$', d) and len(d) > 3 and d.isprintable():
                            constants[f'ms_{restored}'] = d; restored += 1; break
                    except: continue
        result.constants_decrypted = restored; result.constant_map = constants
        return result

    @staticmethod
    def _deserialize_moonveil(result: PipelineResult) -> PipelineResult:
        src = result.source; constants, restored = {}, 0
        for m in re.finditer(r"""\[\s*(\d+)\s*\]\s*=\s*['"]([^'"]+)['"]""", src):
            k, v = int(m.group(1)), m.group(2)
            if len(v) >= 2: constants[f'dispatch_{k}'] = v; restored += 1
        for m in re.finditer(r"""\{['"]([^'"]+)['"]\s*=\s*\{([^}]+)\}\}""", src):
            try:
                k, vc = m.group(1), m.group(2)
                nums = [int(n) & 0xFF for n in re.findall(r'\d+', vc) if 32 <= int(n) <= 126]
                if len(nums) > 3:
                    constants[k] = bytes(nums).decode('latin-1'); restored += 1
            except: continue
        for m in re.finditer(r'string\.char\s*\(\s*(\d+(?:\s*,\s*\d+)+)\s*\)', src):
            try:
                nums = [int(n.strip()) & 0xFF for n in m.group(1).split(',') if 32 <= int(n.strip()) <= 126]
                if len(nums) > 2: constants[f'ch_{restored}'] = bytes(nums).decode('latin-1'); restored += 1
            except: continue
        result.constants_decrypted = restored; result.constant_map = constants
        return result


