class DiagnosticSeverity(Enum):
    INFO = auto()
    WARN = auto()
    ERROR = auto()
    CRITICAL = auto()


@dataclass
class DiagnosticEvent:
    layer: str
    severity: DiagnosticSeverity
    message: str
    details: Optional[str] = None
    traceback: Optional[str] = None


@dataclass
class PipelineResult:
    source: str = ''
    tokens: List['Token'] = field(default_factory=list)
    protector: str = 'Unknown'
    confidence: float = 0.0
    constants_decrypted: int = 0
    constant_map: Dict[str, str] = field(default_factory=dict)
    dead_code_bytes: int = 0
    loops_unrolled: int = 0
    scope_table: Dict[str, List[Dict[str, Any]]] = field(default_factory=dict)
    state_transitions: List[Tuple[int, int]] = field(default_factory=list)
    renamed_vars_count: int = 0
    diagnostics: List[DiagnosticEvent] = field(default_factory=list)

    def log(self, layer: str, severity: DiagnosticSeverity, msg: str, 
            details: str = None, tb: str = None) -> None:
        self.diagnostics.append(DiagnosticEvent(
            layer=layer, severity=severity, message=msg,
            details=details, traceback=tb
        ))

    def to_final_output(self) -> str:
        header = self._build_header()
        return header + '\n' + self.source

    def _build_header(self) -> str:
        sep = '=' * 74
        errors = [d for d in self.diagnostics 
                  if d.severity in (DiagnosticSeverity.ERROR, DiagnosticSeverity.CRITICAL)]
        warnings = [d for d in self.diagnostics if d.severity == DiagnosticSeverity.WARN]
        protector_detail = self.protector
        if self.confidence > 0:
            protector_detail += f' ({self.confidence:.1f}%)'
        
        lines = [
            sep,
            '  LUA STATIC ANALYSIS ENGINE v2.0 — PRODUCTION EDITION',
            sep,
            '',
            f'  Protector(s)           : {protector_detail}',
            '',
            '  -- Constant Restoration --',
            f'  Constants Decrypted    : {self.constants_decrypted}',
            '',
            '  -- Control Flow Unflattening --',
            f'  Dead Code Removed      : {self.dead_code_bytes:,} bytes',
            f'  Dispatch Loops Unrolled: {self.loops_unrolled}',
            f'  State Transitions Mapped: {len(self.state_transitions)}',
            f'  Variables Renamed      : {self.renamed_vars_count}',
            '',
            '  -- Diagnostic Summary --',
            f'  Errors                 : {len(errors)}',
            f'  Warnings               : {len(warnings)}',
            f'  Total Events           : {len(self.diagnostics)}',
            '',
        ]
        if errors:
            lines.append('  -- Error Details --')
            for i, err in enumerate(errors[:10]):
                lines.append(f'  [{i+1}] L{err.layer}: {err.message[:120]}')
                if err.traceback:
                    tb_lines = err.traceback.split('\n')[-3:]
                    for tb_line in tb_lines:
                        lines.append(f'       {tb_line[:100]}')
        if warnings:
            lines.append('  -- Warning Details --')
            for i, warn in enumerate(warnings[:8]):
                lines.append(f'  [{i+1}] L{warn.layer}: {warn.message[:120]}')

        lines.extend([
            '',
            sep,
            '  Generated by Lua Static Analysis Engine v2.0 (Educational Research)',
            '  All analysis performed locally. No network calls made.',
            sep,
        ])
        return '\n'.join(lines)


