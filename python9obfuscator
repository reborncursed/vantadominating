class TokenType(Enum):
    NUMBER = auto(); STRING = auto(); BOOLEAN = auto(); NIL = auto()
    IDENTIFIER = auto(); KEYWORD = auto(); LOCAL = auto(); FUNCTION = auto()
    END = auto(); THEN = auto(); DO = auto(); ELSE = auto(); ELSEIF = auto()
    IF = auto(); WHILE = auto(); REPEAT = auto(); UNTIL = auto(); FOR = auto()
    IN = auto(); RETURN = auto(); BREAK = auto(); CONTINUE = auto()
    ASSIGN = auto(); PLUS = auto(); MINUS = auto(); MUL = auto(); DIV = auto()
    MOD = auto(); POW = auto(); CONCAT = auto(); EQ = auto(); NE = auto()
    LT = auto(); GT = auto(); LE = auto(); GE = auto(); AND = auto(); OR = auto()
    NOT = auto(); LEN = auto(); LPAREN = auto(); RPAREN = auto()
    LBRACKET = auto(); RBRACKET = auto(); LBRACE = auto(); RBRACE = auto()
    COMMA = auto(); SEMI = auto(); COLON = auto(); DOT = auto(); DOTDOT = auto()
    ELLIPSIS = auto(); COMMENT = auto(); BLOCK_COMMENT = auto()
    NEWLINE = auto(); WHITESPACE = auto(); UNKNOWN = auto(); EOF = auto()
    PLUSEQ = auto(); MINUSEQ = auto(); MULEQ = auto(); DIVEQ = auto()


LUA_KEYWORDS: Set[str] = {
    'and', 'break', 'do', 'else', 'elseif', 'end', 'false',
    'for', 'function', 'goto', 'if', 'in', 'local', 'nil',
    'not', 'or', 'repeat', 'return', 'then', 'true', 'until', 'while',
    'continue',
}
KEYWORD_TO_TYPE: Dict[str, TokenType] = {
    'local': TokenType.LOCAL, 'function': TokenType.FUNCTION,
    'end': TokenType.END, 'then': TokenType.THEN, 'do': TokenType.DO,
    'else': TokenType.ELSE, 'elseif': TokenType.ELSEIF, 'if': TokenType.IF,
    'while': TokenType.WHILE, 'repeat': TokenType.REPEAT,
    'until': TokenType.UNTIL, 'for': TokenType.FOR, 'in': TokenType.IN,
    'return': TokenType.RETURN, 'break': TokenType.BREAK,
    'continue': TokenType.CONTINUE,
    'true': TokenType.BOOLEAN, 'false': TokenType.BOOLEAN, 'nil': TokenType.NIL,
    'and': TokenType.AND, 'or': TokenType.OR, 'not': TokenType.NOT,
}


@dataclass
class Token:
    type: TokenType
    value: str
    line: int
    col: int
    raw: str = ''


class LuaTokenizer:
    TOKEN_PATTERNS: List[Tuple[str, Optional[TokenType], Callable]] = [
        (r'--\[\[.*?\]\]', TokenType.BLOCK_COMMENT, None),
        (r'--[^\n]*', TokenType.COMMENT, None),
        (r'\[\[.*?\]\]', TokenType.STRING, None),
        (r'"(?:[^"\\]|\\.)*"', TokenType.STRING, None),
        (r"'(?:[^'\\]|\\.)*'", TokenType.STRING, None),
        (r'\d+\.\d*(?:[eE][+-]?\d+)?', TokenType.NUMBER, None),
        (r'0[xX][0-9a-fA-F]+', TokenType.NUMBER, None),
        (r'\d+', TokenType.NUMBER, None),
        (r'\.\.\.', TokenType.ELLIPSIS, None),
        (r'\.\.', TokenType.CONCAT, None),
        (r'\+=', TokenType.PLUSEQ, None),
        (r'-=', TokenType.MINUSEQ, None),
        (r'\*=', TokenType.MULEQ, None),
        (r'/=', TokenType.DIVEQ, None),
        (r'==', TokenType.EQ, None), (r'~=', TokenType.NE, None),
        (r'<=', TokenType.LE, None), (r'>=', TokenType.GE, None),
        (r'=', TokenType.ASSIGN, None), (r'\+', TokenType.PLUS, None),
        (r'-', TokenType.MINUS, None), (r'\*', TokenType.MUL, None),
        (r'/', TokenType.DIV, None), (r'%', TokenType.MOD, None),
        (r'\^', TokenType.POW, None), (r'<', TokenType.LT, None),
        (r'>', TokenType.GT, None), (r'\(', TokenType.LPAREN, None),
        (r'\)', TokenType.RPAREN, None), (r'\[', TokenType.LBRACKET, None),
        (r'\]', TokenType.RBRACKET, None), (r'\{', TokenType.LBRACE, None),
        (r'\}', TokenType.RBRACE, None), (r',', TokenType.COMMA, None),
        (r';', TokenType.SEMI, None), (r':', TokenType.COLON, None),
        (r'\.', TokenType.DOT, None), (r'#', TokenType.LEN, None),
        (r'[a-zA-Z_][a-zA-Z0-9_]*', TokenType.IDENTIFIER, None),
        (r'\s+', TokenType.WHITESPACE, None), (r'\n', TokenType.NEWLINE, None),
        (r'.', TokenType.UNKNOWN, None),
    ]
    _combined = re.compile('|'.join(f'({p[0]})' for p in TOKEN_PATTERNS))

    def __init__(self, source: str):
        self.source = source
        self.tokens: List[Token] = []
        self._tokenize()

    def _resolve_keyword(self, ident: str) -> TokenType:
        return KEYWORD_TO_TYPE.get(ident, TokenType.IDENTIFIER)

    def _tokenize(self) -> None:
        line, col = 1, 1
        for match in self._combined.finditer(self.source):
            raw = match.group(0)
            for i, (pattern, token_type, _) in enumerate(self.TOKEN_PATTERNS):
                if match.group(i + 1) is not None:
                    if token_type == TokenType.WHITESPACE:
                        col += len(raw); break
                    final_type = token_type
                    if final_type == TokenType.IDENTIFIER:
                        final_type = self._resolve_keyword(raw)
                    self.tokens.append(Token(final_type, raw, line, col, raw))
                    if raw == '\n': line += 1; col = 1
                    else: col += len(raw)
                    break

    def get_tokens(self, skip_ws: bool = True) -> List[Token]:
        if skip_ws:
            return [t for t in self.tokens if t.type not in 
                    (TokenType.WHITESPACE, TokenType.COMMENT, TokenType.BLOCK_COMMENT)]
        return self.tokens


class ScopeAnalyzer:
    def __init__(self, tokens: List[Token]):
        self.tokens = tokens
        self.scope_stack: List[Dict[str, List[Any]]] = [{}]
        self.symbol_table: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
        self.current_line = 0

    def analyze(self) -> Dict[str, List[Dict[str, Any]]]:
        i = 0
        while i < len(self.tokens):
            t = self.tokens[i]
            self.current_line = t.line
            if t.type in (TokenType.IF, TokenType.WHILE, TokenType.FOR,
                          TokenType.DO, TokenType.REPEAT):
                self._enter_scope()
            elif t.type == TokenType.FUNCTION:
                if i > 0 and self.tokens[i-1].type == TokenType.LOCAL:
                    self._enter_scope()
                else: self._enter_scope()
            elif t.type == TokenType.END: self._exit_scope()
            elif t.type == TokenType.UNTIL: self._exit_scope()
            elif t.type == TokenType.LOCAL:
                vars_declared = self._parse_local_declaration(i)
                i += vars_declared - 1
            elif t.type == TokenType.IDENTIFIER:
                self._track_assignment(i)
            i += 1
        return dict(self.symbol_table)

    def _enter_scope(self) -> None: self.scope_stack.append({})
    def _exit_scope(self) -> None:
        if len(self.scope_stack) > 1:
            exited = self.scope_stack.pop()
            for k, v in exited.items():
                if k in self.scope_stack[-1]: self.scope_stack[-1][k].extend(v)
                else: self.scope_stack[-1][k] = v

    def _parse_local_declaration(self, start: int) -> int:
        if start + 1 >= len(self.tokens): return 1
        t2 = self.tokens[start + 1]
        if t2.type == TokenType.FUNCTION:
            if start + 2 < len(self.tokens) and self.tokens[start+2].type == TokenType.IDENTIFIER:
                self._declare_variable(self.tokens[start+2].value, 'function')
                return 3
            return 2
        if t2.type == TokenType.IDENTIFIER:
            vname = t2.value
            if start + 2 < len(self.tokens) and self.tokens[start+2].type == TokenType.ASSIGN:
                val = self._extract_value(start + 3)
                self._declare_variable(vname, val)
                return 3 + self._count_expr(start + 3)
            self._declare_variable(vname, None); return 2
        return 1

    def _declare_variable(self, name: str, value: Any) -> None:
        cs = self.scope_stack[-1]
        if name not in cs: cs[name] = []
        cs[name].append({'value': value, 'line': self.current_line, 'scope_depth': len(self.scope_stack)})
        self.symbol_table[name].append(cs[name][-1])

    def _track_assignment(self, idx: int) -> None:
        if idx + 1 >= len(self.tokens): return
        if self.tokens[idx+1].type != TokenType.ASSIGN: return
        name = self.tokens[idx].value
        for scope in reversed(self.scope_stack):
            if name in scope:
                val = self._extract_value(idx + 2)
                scope[name].append({'value': val, 'line': self.current_line,
                                    'scope_depth': len(self.scope_stack), 'reassign': True})
                self.symbol_table[name].append(scope[name][-1])
                break

    def _extract_value(self, start: int) -> Any:
        if start >= len(self.tokens): return None
        t = self.tokens[start]
        if t.type == TokenType.NUMBER: return float(t.value) if '.' in t.value else int(t.value)
        elif t.type == TokenType.STRING: return t.value[1:-1] if len(t.value) >= 2 else t.value
        elif t.type == TokenType.BOOLEAN: return t.value == 'true'
        elif t.type == TokenType.NIL: return None
        elif t.type == TokenType.MINUS and start+1 < len(self.tokens) and self.tokens[start+1].type == TokenType.NUMBER:
            v = self.tokens[start+1].value; return -float(v) if '.' in v else -int(v)
        elif t.type == TokenType.LBRACE: return self._extract_table(start)
        return None

    def _extract_table(self, start: int) -> Dict:
        result = {}
        if start >= len(self.tokens) or self.tokens[start].type != TokenType.LBRACE: return result
        i, depth = start + 1, 1
        while i < len(self.tokens) and depth > 0:
            t = self.tokens[i]
            if t.type == TokenType.LBRACE: depth += 1
            elif t.type == TokenType.RBRACE: depth -= 1
            elif t.type == TokenType.LBRACKET and depth == 1:
                key = self._extract_value(i + 1)
                j = i + 1
                while j < len(self.tokens) and self.tokens[j].type != TokenType.RBRACKET: j += 1
                if j + 1 < len(self.tokens) and self.tokens[j+1].type == TokenType.ASSIGN:
                    result[str(key)] = self._extract_value(j + 2)
            elif t.type == TokenType.IDENTIFIER and depth == 1:
                if i + 1 < len(self.tokens) and self.tokens[i+1].type == TokenType.ASSIGN:
                    result[t.value] = self._extract_value(i + 2)
            i += 1
        return result

    def _count_expr(self, start: int) -> int:
        cnt, dp, db, dk = 0, 0, 0, 0
        i = start
        while i < len(self.tokens):
            t = self.tokens[i]
            if t.type == TokenType.LPAREN: dp += 1
            elif t.type == TokenType.RPAREN: dp -= 1
            elif t.type == TokenType.LBRACE: db += 1
            elif t.type == TokenType.RBRACE: db -= 1
            elif t.type == TokenType.LBRACKET: dk += 1
            elif t.type == TokenType.RBRACKET: dk -= 1
            elif t.type in (TokenType.COMMA, TokenType.SEMI) and dp == 0 and db == 0: break
            elif t.type in (TokenType.END, TokenType.NEWLINE): break
            cnt += 1; i += 1
            if dp < 0 or db < 0: break
        return max(cnt, 1)


