                if dec: cons[m.group(1)]=dec; rst+=1
        for m in re.finditer(r'table\.concat\s*\(\s*\{([^}]+)\}\s*\)',src):
            nums=[int(n)&0xFF for n in re.findall(r'\d+',m.group(1)) if n.strip()]
            if len(nums)>3:
                dec=ConstantDeserializer._try_xor(nums)
                if dec: cons[f'cat_{rst}']=dec; rst+=1
        mod=src
        for vn,dc in cons.items():
            if vn.startswith('LPH_'): mod=mod.replace(vn,f'"{dc}"')
        result.source=mod; result.constants_decrypted=rst; result.constant_map=cons
        return result

    @staticmethod
    def _moonsec(result:PipelineResult)->PipelineResult:
        src=result.source; cons={}; rst=0
        hx={}
        for m in re.finditer(r'_0x([0-9a-fA-F]+)\s*=\s*(\d+)',src):
            hx[f'_0x{m.group(1)}']=int(m.group(2))
        for m in re.finditer(r'\{([^}]*string\.byte[^}]*)\}',src):
            nums=[int(n)&0xFF for n in re.findall(r'\d+',m.group(1)) if n.strip()]
            if len(nums)>3:
                for k in list(hx.values())[:5]+[0,1,2,255]:
                    tb=[b^((k+i)%256) for i,b in enumerate(nums)]
                    try:
                        d=bytes(tb).decode('latin-1')
                        if re.match(r'^[\x20-\x7E]+$',d) and len(d)>3 and d.isprintable():
                            cons[f'ms_{rst}']=d; rst+=1; break
                    except: continue
        result.constants_decrypted=rst; result.constant_map=cons
        return result

    @staticmethod
    def _moonveil(result:PipelineResult)->PipelineResult:
        src=result.source; cons={}; rst=0
        for m in re.finditer(r"""\[\s*(\d+)\s*\]\s*=\s*['"]([^'"]+)['"]""",src):
            if len(m.group(2))>=2: cons[f'd_{m.group(1)}']=m.group(2); rst+=1
        for m in re.finditer(r"""\{['"]([^'"]+)['"]\s*=\s*\{([^}]+)\}\}""",src):
            try:
                nums=[int(n)&0xFF for n in re.findall(r'\d+',m.group(2)) if 32<=int(n)<=126]
                if len(nums)>3: cons[m.group(1)]=bytes(nums).decode('latin-1'); rst+=1
            except: continue
        result.constants_decrypted=rst; result.constant_map=cons
        return result

    @staticmethod
    def _ironbrew_family(result:PipelineResult, xor:bool=False)->PipelineResult:
        src=result.source; cons={}; rst=0
        for m in re.finditer(r'local\s+\w+\s*=\s*\{(\d+(?:\s*,\s*\d+)+)\}',src):
            nums=[int(n)&0xFF for n in re.findall(r'\d+',m.group(1)) if 0<=int(n)<=255]
            if len(nums)>10:
