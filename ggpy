                                cons[f'ib_{rst}']=d; rst+=1; break
                        except: continue
                else:
                    dec=ConstantDeserializer._try_xor(nums)
                    if dec: cons[f'xr_{rst}']=dec; rst+=1
        for m in re.finditer(r'string\.char\s*\(\s*(\d+(?:\s*,\s*\d+)+)\s*\)',src):
            nums=[int(n.strip())&0xFF for n in m.group(1).split(',') if 32<=int(n.strip())<=126]
            if len(nums)>2:
                try: cons[f'str_{rst}']=bytes(nums).decode('latin-1'); rst+=1
                except: continue
