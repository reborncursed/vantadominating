    diagnostics: List[DiagnosticEvent] = field(default_factory=list)

    def log(self, layer: str, sev: DiagnosticSeverity, msg: str,
            details: str = None, tb: str = None):
        self.diagnostics.append(DiagnosticEvent(layer, sev, msg, details, tb))

    def to_final_output(self) -> str:
        sep = '=' * 74
        errs = [d for d in self.diagnostics if d.severity in (DiagnosticSeverity.ERROR,DiagnosticSeverity.CRITICAL)]
        warns = [d for d in self.diagnostics if d.severity == DiagnosticSeverity.WARN]
        pd = f'{self.protector} ({self.confidence:.1f}%)' if self.confidence > 0 else self.protector
        lines = [
            sep,
            '  LUA STATIC ANALYSIS ENGINE v3.0 — FINAL MERGED EDITION',
            sep, '',
            f'  Protector(s)           : {pd}', '',
            '  -- Constant Restoration --',
            f'  Constants Decrypted    : {self.constants_decrypted}', '',
            '  -- Control Flow Unflattening --',
            f'  Dead Code Removed      : {self.dead_code_bytes:,} bytes',
            f'  Dispatch Loops Unrolled: {self.loops_unrolled}',
            f'  State Transitions Mapped: {len(self.state_transitions)}',
            f'  Variables Renamed      : {self.renamed_vars_count}', '',
            '  -- Diagnostic Summary --',
            f'  Errors                 : {len(errs)}',
            f'  Warnings               : {len(warns)}',
            f'  Total Events           : {len(self.diagnostics)}', '',
        ]
        if errs:
            lines.append('  -- Error Details --')
            for i,e in enumerate(errs[:10]):
                lines.append(f'  [{i+1}] L{e.layer}: {e.message[:120]}')
                if e.traceback:
                    for tb in e.traceback.split('\n')[-3:]:
                        lines.append(f'       {tb[:100]}')
        if warns:
            lines.append('  -- Warning Details --')
            for i,w in enumerate(warns[:8]):
                lines.append(f'  [{i+1}] L{w.layer}: {w.message[:120]}')
        lines.extend(['', sep,
            '  Generated by Lua Static Analysis Engine v3.0 (Educational Research)',
            '  All analysis performed locally. No network calls made.', sep])
        return '\n'.join(lines)

