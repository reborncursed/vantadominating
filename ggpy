class LuaDeobfuscationEngine:
    @classmethod
    def run(cls, raw_source: str) -> str:
        result = PipelineResult(source=raw_source)
        result.log('Engine',DiagnosticSeverity.INFO,f'v3.0 started. Input: {len(raw_source):,} bytes')

        # L1: Tokenize
        try:
            tok=LuaTokenizer(raw_source); result.tokens=tok.get_tokens()
            sa=ScopeAnalyzer(result.tokens); result.scope_table=sa.analyze()
            result.log('L1',DiagnosticSeverity.INFO,f'{len(result.tokens)} tokens, {len(result.scope_table)} vars')
        except Exception as e:
            result.log('L1',DiagnosticSeverity.ERROR,f'Tokenize: {e}',tb=traceback.format_exc())

        # L2: Identify
        try:
            p,c,d=ProtectorIdentifier.identify(result.source)
            result.protector=p; result.confidence=c
            result.log('L2',DiagnosticSeverity.INFO,f'=> {p} ({c:.1f}%)')
        except Exception as e:
            result.log('L2',DiagnosticSeverity.ERROR,f'ID: {e}',tb=traceback.format_exc())

        # L3: Deserialize
        result=ConstantDeserializer.deserialize(result)
        result.log('L3',DiagnosticSeverity.INFO,f'Decrypted {result.constants_decrypted} constants')

        # L4: Unroll
        result=ControlFlowUnroller.unroll(result)
        result.log('L4',DiagnosticSeverity.INFO,
            f'Removed {result.dead_code_bytes:,} dead bytes, {result.loops_unrolled} loops, {result.renamed_vars_count} renamed')

        # L5: Beautify
        try:
            result.source=LuaBeautifier.beautify(result.source)
        except Exception as e:
            result.log('L5',DiagnosticSeverity.WARN,f'Beautify: {e}')
            result.source=LuaBeautifier._basic(result.source)

        result.log('Engine',DiagnosticSeverity.INFO,'Pipeline complete')
        return result.to_final_output()


