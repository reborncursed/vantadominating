class NameManglerRenamer:
    _ILLUSION = re.compile(r'\b([O0lI]{4,})\b')
    @staticmethod
    def normalize(tokens: List[Token]) -> Tuple[List[Token],int]:
        rmap={}; cnt=0; mod=list(tokens)
        for i,t in enumerate(mod):
            if t.type!=TokenType.IDENTIFIER: continue
            v=t.value
            if NameManglerRenamer._ILLUSION.fullmatch(v):
                if v not in rmap: cnt+=1; rmap[v]=f'loc_{cnt}'
                mod[i]=Token(TokenType.IDENTIFIER,rmap[v],t.line,t.col,t.raw)
            elif len(v)==1 and v.isalpha() and v.islower() and v not in LUA_KEYWORDS:
                if v not in rmap: cnt+=1; rmap[v]=f'var_{cnt}'
                mod[i]=Token(TokenType.IDENTIFIER,rmap[v],t.line,t.col,t.raw)
        return mod,cnt

class ControlFlowUnroller:
    @staticmethod
    def unroll(result: PipelineResult) -> PipelineResult:
        try:
            src=result.source
            # Rename pass for mangled protectors
            if result.protector in ('Azkaban','BillChirico','Generic/Obfuscated','Unknown/Clean'):
                try:
                    tok=LuaTokenizer(src); ts=tok.get_tokens(skip_ws=False)
                    rt,rc=NameManglerRenamer.normalize(ts)
                    result.renamed_vars_count=rc
                    if rc>0:
                        src=''.join(t.value if t.type!=TokenType.NEWLINE else '\n' for t in rt)
                        result.log('L4',DiagnosticSeverity.INFO,f'Renamed {rc} obfuscated vars')
                except Exception as e:
                    result.log('L4',DiagnosticSeverity.WARN,f'Rename fail: {e}')

            src,rem=ControlFlowUnroller._strip_dead(src); result.dead_code_bytes+=rem
            src,unr,trans=ControlFlowUnroller._unroll_dispatch(src)
            result.loops_unrolled+=unr; result.state_transitions.extend(trans)
            src=ControlFlowUnroller._inline_proxies(src)
            src=ControlFlowUnroller._cleanup(src)
            result.source=src
        except Exception as e:
            result.log('L4',DiagnosticSeverity.ERROR,f'Unroll: {e}',tb=traceback.format_exc())
        return result

    @staticmethod
    def _strip_dead(src:str)->Tuple[str,int]:
        rem=0; m=src
        o=len(m); m=re.sub(r'--\[\[\s*\]\]','',m); m=re.sub(r'--\[\[\s*--\s*\]\]','',m); rem+=o-len(m)
        o=len(m); m=re.sub(r'if\s+false\s+then\s*(?:(?!\bend\b).)*\bend\b','',m,flags=re.DOTALL); rem+=o-len(m)
        def _eval(m2):
            b=m2.group(1); cm=re.match(r'if\s+(\d+)\s*==\s*(\d+)\s*then',m2.group(0))
            if cm: return b.strip() if int(cm.group(1))==int(cm.group(2)) else ''
            return m2.group(0)
        m=re.sub(r'if\s+\d+\s*==\s*\d+\s*then\s*([\s\S]*?)\bend\b',_eval,m)
        o=len(m); m=re.sub(r'while\s+false\s+do[\s\S]*?\bend\b','',m); rem+=o-len(m)
        return m,rem

    @staticmethod
    def _unroll_dispatch(src:str)->Tuple[str,int,List[Tuple[int,int]]]:
        unrolled=0; all_t=[]
        def _handler(m):
            nonlocal unrolled,all_t
            body=m.group(1)
            blocks=ControlFlowUnroller._extract_blocks(body)
            if not blocks or len(blocks)<3: return m.group(0)
            trans,svar=ControlFlowUnroller._build_graph(body,blocks)
            if not trans: return m.group(0)
            all_t.extend(trans)
            init_m=re.search(re.escape(svar)+r'\s*=\s*(\d+)',src[:m.start()])
            init=int(init_m.group(1)) if init_m else min(b['state'] for b in blocks)
            sb=ControlFlowUnroller._traverse(blocks,trans,init)
            if not sb: return m.group(0)
            unrolled+=1
            parts=[]
            for i,b in enumerate(sb):
                cc=re.sub(re.escape(b.get('var',svar))+r'\s*=\s*[^;\n]+[;\n]?','',b['code'])
                cc=re.sub(r'\bbreak\b','',cc)
                parts.append(f"-- [[ State {b['state']} ({i+1}/{len(sb)}) ]]\n{cc.strip()}")
            return '\n'.join(parts)
        m=re.sub(r'while\s+(?:true|1)\s+do\s*([\s\S]*?)\bend\b',_handler,src)
        return m,unrolled,all_t

    @staticmethod
    def _extract_blocks(body:str)->List[Dict]:
        blocks=[]
        for m in re.finditer(r'(?:if|elseif)\s+(\w+)\s*==\s*(\d+)\s*then\s*([\s\S]*?)(?=elseif|\bend\b)',body):
            blocks.append({'state':int(m.group(2)),'var':m.group(1),'code':m.group(3).strip()})
        seen=set(); uq=[]
        for b in blocks:
            if b['state'] not in seen: seen.add(b['state']); uq.append(b)
        return sorted(uq,key=lambda b:b['state'])

    @staticmethod
    def _build_graph(body:str,blocks:List[Dict])->Tuple[List[Tuple[int,int]],str]:
        trans=[]; sv=blocks[0]['var'] if blocks else ''
        for b in blocks:
            for am in re.finditer(re.escape(sv)+r'\s*=\s*(\d+)',b['code']):
                trans.append((b['state'],int(am.group(1))))
        if not trans and len(blocks)>1:
            for i in range(len(blocks)-1): trans.append((blocks[i]['state'],blocks[i+1]['state']))
            trans.append((blocks[-1]['state'],blocks[0]['state']))
        return trans,sv

    @staticmethod
    def _traverse(blocks,transitions,initial):
        bmap={b['state']:b for b in blocks}
        adj=defaultdict(list)
        for s,d in transitions: adj[s].append(d)
        seen=set(); order=[]
        def dfs(state,depth=0):
            if depth>50: return
            if state in seen: return
            if state not in bmap: return
            seen.add(state)
            if state in bmap: order.append(bmap[state])
            for ns in adj.get(state,[]): dfs(ns,depth+1)
        dfs(initial)
        return order or sorted(blocks,key=lambda b:b['state'])

    @staticmethod
    def _inline_proxies(src:str)->str:
        m=src
        for mt in re.finditer(r'local\s+(\w+)\s*=\s*function\s*\((\w+)\)\s*return\s*\2\s*end\s*',m):
            m=re.sub(r'local\s+'+re.escape(mt.group(1))+r'\s*=\s*function\s*\(\w+\)\s*return\s*\w+\s*end\s*','',m,count=1)
            m=re.sub(re.escape(mt.group(1))+r'\s*\(\s*([^)]+)\s*\)',r'\1',m)
        return m

    @staticmethod
    def _cleanup(src:str)->str:
        m=src; m=re.sub(r'do\s*\bend\b','',m); m=re.sub(r'then\s*\bend\b','',m)
        m=re.sub(r'\n{3,}','\n\n',m); return m

