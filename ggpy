class ConstantDeserializer:
    _XOR_KEYS = [0,1,2,5,13,42,128,255]

    @staticmethod
    def deserialize(result: PipelineResult) -> PipelineResult:
        try:
            if not result.tokens:
                tok=LuaTokenizer(result.source); result.tokens=tok.get_tokens()
            ScopeAnalyzer(result.tokens).analyze()
            p=result.protector
            if 'Luraph' in p: return ConstantDeserializer._luraph(result)
            if 'MoonSec' in p: return ConstantDeserializer._moonsec(result)
            if 'Moonveil' in p: return ConstantDeserializer._moonveil(result)
            if p in ('IronBrew','XorBrew'): return ConstantDeserializer._ironbrew_family(result,'Xor' in p)
            if p=='Lumen': return ConstantDeserializer._lumen(result)
            if p in ('Synapse Xen','Clyde Luau'): return ConstantDeserializer._synapse_clyde(result)
            if p in ('ScriptShield','Hercules'): return ConstantDeserializer._shield_hercules(result)
            return ConstantDeserializer._web_minifier(result)
        except Exception as e:
            result.log('L3',DiagnosticSeverity.ERROR,f'Deserialize: {e}',tb=traceback.format_exc())
            return result

    @staticmethod
    def _try_xor(bl: List[int], key:int=None)->Optional[str]:
        if not bl or len(bl)<2: return None
        try:
            d=bytes(bl).decode('latin-1')
            if d.isprintable() and len(d)>2 and any(c.isalpha() for c in d): return d
        except: pass
        for k in ([key] if key is not None else range(256)):
            try:
                d=bytes(b^k for b in bl).decode('latin-1')
                if re.match(r'^[\x20-\x7E]+$',d) and len(d)>2 and any(c.isalpha() for c in d): return d
            except: continue
        for base in ConstantDeserializer._XOR_KEYS:
            try:
                d=bytes(b^((base+i)%256) for i,b in enumerate(bl)).decode('latin-1')
                if re.match(r'^[\x20-\x7E]+$',d) and len(d)>2 and any(c.isalpha() for c in d): return d
            except: continue
        return None

    @staticmethod
    def _extract_bytes(src:str, start:int)->Tuple[List[int],int]:
        if start>=len(src) or src[start]!='{': return [],start
        bl,depth,i,num=[],1,start+1,''
        while i<len(src) and depth>0:
            ch=src[i]
            if ch=='{': depth+=1
            elif ch=='}':
                depth-=1
                if depth==0:
                    if num.strip():
                        try: bl.append(int(eval(num.strip()))&0xFF)
                        except: pass
                    break
                if num.strip():
                    try: bl.append(int(eval(num.strip()))&0xFF)
                    except: pass; num=''
            elif ch==',':
                if num.strip():
                    try: bl.append(int(eval(num.strip()))&0xFF)
                    except: pass; num=''
            elif ch.isdigit() or ch in 'xXabcdefABCDEF+-*/%': num+=ch
            elif ch in ' \t': pass
            else: num+=ch
            i+=1
        return bl,i+1

    @staticmethod
    def _luraph(result:PipelineResult)->PipelineResult:
        src=result.source; cons={}; rst=0
        for m in re.finditer(r'local\s+(LPH_\d+)\s*=\s*\{',src):
            bl,_=ConstantDeserializer._extract_bytes(src,m.end()-1)
            if len(bl)>3:
