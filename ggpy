def deobfuscate_lua_code(raw_code: str) -> str:
    """Primary entry point. Call this from your bot or main file.
    
    Args:
        raw_code: The raw obfuscated Lua source code as a string.
        
    Returns:
        Formatted deobfuscated output with analysis header.
    """
    return LuaDeobfuscationEngine.run(raw_code)


