class ProtectorIdentifier:
    @classmethod
    def identify(cls, source: str) -> Tuple[str, float, Dict[str,Any]]:
        details = {
            'Luraph V4':0,'Luraph V3':0,'MoonSec':0,'Moonveil':0,
            'IronBrew':0,'XorBrew':0,'Lumen':0,'Synapse Xen':0,
            'Clyde Luau':0,'ScriptShield':0,'Hercules':0,'Azkaban':0,'BillChirico':0,
        }
        inds = {k:[] for k in details}
        if not source or len(source)<10: return ('Unknown',0.0,{})

        # Luraph V4
        for p,w,d in [(r'string\.dump\s*\([^)]*\)\s*:\s*byte\s*\(',15,'dump CRC'),
            (r'debug\.getinfo\s*\(',10,'getinfo probe'),
            (r'(?:getfenv|setfenv)\s*\([^)]*\)',10,'env proxy'),
            (r'if\s+not\s+[\w_]+\s+then\s+return\s+end',12,'init guard'),
            (r'=\s*0[xX][0-9a-fA-F]{8}',8,'hex CRC'),
            (r'bit32?\.(?:bxor|band|bor)\s*\([^)]*\)',12,'bit32 XOR'),
            (r'pcall\s*\(\s*function\s*\(\)[\s\S]*?check[\s\S]*?end\s*\)',10,'canary')]:
            n=len(re.findall(p,source,re.DOTALL))
            if n>0: details['Luraph V4']+=w*min(n,3); inds['Luraph V4'].append(f'{d}(x{n})')

        # Luraph V3
        for p,w,d in [(r'LPH_\d+\s*=',25,'LPH_'),(r'LPH_\d+\s*=\s*string\.(?:byte|char|sub|len)\b',20,'LPH alias'),
            (r'table\.concat\s*\([^)]*byte[^)]*\)',15,'concat')]:
            n=len(re.findall(p,source))
            if n>0: details['Luraph V3']+=w*min(n,2); inds['Luraph V3'].append(f'{d}(x{n})')

        # MoonSec
        for p,w,d in [(r'_0x[0-9a-fA-F]{2,8}',25,'hex vars'),(r'string\.byte\s*\(',10,'byte'),(r'string\.char\s*\(',10,'char'),
            (r'local\s+_\w+\s*=\s*string\.',15,'macros')]:
            n=len(re.findall(p,source))
            if n>0: details['MoonSec']+=w*min(n,3); inds['MoonSec'].append(f'{d}(x{n})')

        # Moonveil
        for p,w,d in [(r'(?:if\s+.*?==\s*\d+\s*then[\s\S]*?elseif\s+.*?==\s*\d+\s*then){5,}',30,'dispatch'),
            (r'\[\s*\d+\s*\]\s*=\s*function\s*\(',20,'entries'),(r'(\w+)\s*=\s*\1\s*\+\s*\d+',8,'state arith')]:
            n=len(re.findall(p,source,re.DOTALL))
            if n>0: details['Moonveil']+=w*min(n,3); inds['Moonveil'].append(f'{d}(x{n})')

        # IronBrew
        if re.search(r'Iron[Bb]rew',source): details['IronBrew']+=30; inds['IronBrew'].append('header')
        ib_d=len(re.findall(r'(Inst|Ins)\[\d+\]',source))
        if ib_d>8: details['IronBrew']+=20; inds['IronBrew'].append(f'dispatch(x{ib_d})')
        if re.search(r'local\s+\w+\s*=\s*\{(\d+,){50,}\d+\}',source): details['IronBrew']+=15; inds['IronBrew'].append('opcode arr')

        # XorBrew
        if re.search(r'Xor[Bb]rew',source): details['XorBrew']+=35; inds['XorBrew'].append('header')
        bx=len(re.findall(r'bit[32]*\.bxor\s*\(',source))
        if bx>5: details['XorBrew']+=25; inds['XorBrew'].append(f'bxor(x{bx})')

        # Lumen
        if re.search(r'[Ll]umen',source): details['Lumen']+=25; inds['Lumen'].append('header')
        if re.search(r'math\.floor\s*\(\s*\w+\s*/\s*\d+',source): details['Lumen']+=20; inds['Lumen'].append('bit extract')

        # Synapse Xen
        if re.search(r'(syn|SYNAPSE|__syn)',source,re.I): details['Synapse Xen']+=25; inds['Synapse Xen'].append('marker')
        if re.findall(r'"(?:[0-9a-fA-F]{2}){100,}"',source): details['Synapse Xen']+=20; inds['Synapse Xen'].append('hex blob')
        if re.search(r'load(?:string|)\s*\([^)]*hex',source,re.I): details['Synapse Xen']+=15; inds['Synapse Xen'].append('loadstring(hex)')
        if len(re.findall(r'bit32\.',source))>15: details['Synapse Xen']+=10; inds['Synapse Xen'].append('bit32 heavy')

        # Clyde Luau
        if re.search(r'CLYDE',source): details['Clyde Luau']+=30; inds['Clyde Luau'].append('marker')
        if re.search(r'\+=|-=|\*=|/=',source): details['Clyde Luau']+=20; inds['Clyde Luau'].append('compound ops')
        hx=len(re.findall(r'\\x[0-9a-fA-F]{2}',source))
        if hx>20: details['Clyde Luau']+=15; inds['Clyde Luau'].append(f'hex escapes(x{hx})')

        # ScriptShield
        if re.search(r'(Script[Ss]hield|SS_|SShield)',source): details['ScriptShield']+=30; inds['ScriptShield'].append('marker')
        if re.search(r'getfenv|setfenv',source) and re.search(r'__index',source): details['ScriptShield']+=20; inds['ScriptShield'].append('env proxy')

        # Hercules
        if re.search(r'[Hh]ercules',source): details['Hercules']+=25; inds['Hercules'].append('marker')
        if re.search(r'__index.*__call',source): details['Hercules']+=20; inds['Hercules'].append('meta intercept')

        # Azkaban
        if re.search(r'[Aa]zkaban',source): details['Azkaban']+=25; inds['Azkaban'].append('marker')
        o0=len(re.findall(r'\b[O0lI]{8,}\b',source))
        if o0>10: details['Azkaban']+=20; inds['Azkaban'].append(f'O0lI vars(x{o0})')
        op=len(re.findall(r'if\s+\d+%?\s*==?\s*\d+',source))
        if op>15: details['Azkaban']+=15; inds['Azkaban'].append(f'opaque(x{op})')

        # BillChirico
        if re.search(r'LUA-Obfuscator\.com|BillChirico|Illusion',source,re.I): details['BillChirico']+=30; inds['BillChirico'].append('header')
        il=len(re.findall(r'\b[Il]+\b',source))
        if il>15: details['BillChirico']+=25; inds['BillChirico'].append(f'Il vars(x{il})')

        max_s = max(details.values()) if details else 0
        if max_s>=20:
            winner = max(details, key=details.get)
            return (winner, min(round((max_s/120)*100,1),96.0), details)
        esc=len(re.findall(r'\\x[0-9a-fA-F]{2}',source))
        if esc>20: return ('Generic/Obfuscated',30.0,details)
        return ('Unknown/Clean',0.0,details)

