class LuaBeautifier:
    _UP = {'then','do','else','elseif','function','repeat'}
    _DOWN = {'end','else','elseif','until'}
    _SPACE_OPS = {'=','+','-','*','/','%','^','..','==','~=','<=','>=','<','>'}
    
    @classmethod
    def beautify(cls, source: str) -> str:
        try:
            tok = LuaTokenizer(source); ts = tok.get_tokens(skip_ws=False)
            return cls._format(ts)
        except Exception:
            return cls._basic(source)

    @classmethod
    def _format(cls, tokens: List[Token]) -> str:
        lines=[]; cur=[]; indent=0; line_start=True
        for i,t in enumerate(tokens):
            if t.type==TokenType.KEYWORD and t.value in cls._DOWN and line_start:
                indent=max(0,indent-1)
            if t.type==TokenType.NEWLINE:
                if cur:
                    txt=''.join(cur).strip()
                    if txt: lines.append('  '*indent+txt)
                    cur=[]; line_start=True
                continue
            if t.type==TokenType.WHITESPACE: continue
            sp=''
            if line_start: sp=''; line_start=False
            else:
                if t.value in cls._SPACE_OPS: sp=' '
                elif t.value==',': sp=', '; t=Token(t.type,'',t.line,t.col,t.raw)
                else: sp=' '
            cur.append(sp+t.value)
            if t.type==TokenType.KEYWORD and t.value in cls._UP and not line_start:
                nr=cls._next(tokens,i+1)
                if nr and nr.value!='end': indent+=1
        if cur:
            txt=''.join(cur).strip()
            if txt: lines.append('  '*indent+txt)
        return '\n'.join(lines)

    @staticmethod
    def _next(tokens,start):
        for i in range(start,min(start+10,len(tokens))):
            if tokens[i].type not in (TokenType.WHITESPACE,TokenType.COMMENT,TokenType.BLOCK_COMMENT,TokenType.NEWLINE):
                return tokens[i]
        return None

    @staticmethod
    def _basic(source:str)->str:
        s=source.replace('\r\n','\n'); s=re.sub(r'\n{3,}','\n\n',s)
        s=re.sub(r'\s*=\s*',' = ',s); s=re.sub(r'\s*,\s*',', ',s)
        lines=s.split('\n'); indent=0; res=[]
        for line in lines:
            st=line.strip()
            if not st: res.append(''); continue
            if any(st.startswith(k) for k in ('end','else','elseif','until')): indent=max(0,indent-1)
            res.append('  '*indent+st)
            if any(st.endswith(k) for k in ('then','do')) or st=='else' or st.startswith('function') or st=='repeat': indent+=1
        return '\n'.join(res)

