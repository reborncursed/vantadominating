class Layer1Identifier:
    """
    Structural scanner that reads raw input and detects protector signatures.
    Uses heuristic scoring across three protector families.
    """
    
    @staticmethod
    def identify(source: str) -> Dict[str, Any]:
        """
        Scan source code for protector signatures.
        
        Args:
            source: Raw Lua script source
            
        Returns:
            Dict with protector name, confidence score, and detailed breakdown
        """
        result = {
            'protector': 'Unknown',
            'confidence': 0,
            'details': {
                'luraph': {'score': 0, 'indicators': []},
                'moonsec': {'score': 0, 'indicators': []},
                'moonveil': {'score': 0, 'indicators': []},
            }
        }
        
        if not source or len(source) < 10:
            return result
        
        # --- Luraph (LPH) Signatures ---
        # Global LPH_0 through LPH_n constant declarations
        lph_globals = len(re.findall(r'LPH_\d+\s*=', source))
        if lph_globals > 3:
            result['details']['luraph']['score'] += 25
            result['details']['luraph']['indicators'].append(
                f"LPH_ globals: {lph_globals}"
            )
        
        # Luraph string allocation blocks: LPH_X = string.byte/char
        lph_aliases = len(re.findall(
            r'LPH_\d+\s*=\s*string\.(?:byte|char|sub|len)\b', source
        ))
        if lph_aliases > 2:
            result['details']['luraph']['score'] += 20
            result['details']['luraph']['indicators'].append(
                f"string.* aliased via LPH_: {lph_aliases}"
            )
        
        # Bitwise translation headers
        lph_bitwise = len(re.findall(r'bit\.?[a-z]+', source, re.I))
        lph_arith = len(re.findall(
            r'LPH_\d+\s*=\s*\d+\s*\+\s*LPH_\d+', source
        ))
        if lph_bitwise + lph_arith > 5:
            result['details']['luraph']['score'] += 15
            result['details']['luraph']['indicators'].append(
                "Bitwise/arithmetic translation patterns"
            )
        
        # table.concat byte reconstruction
        lph_concat = len(re.findall(
            r'table\.concat\s*\([^)]*byte[^)]*\)', source, re.I
        ))
        if lph_concat > 0:
            result['details']['luraph']['score'] += 15
            result['details']['luraph']['indicators'].append(
                "table.concat byte reconstruction"
            )
        
        # --- MoonSec Signatures ---
        # Hex variable chains (_0x followed by hex digits)
        hex_vars = re.findall(r'_0x[0-9a-fA-F]{2,8}', source)
        if len(hex_vars) > 5:
            result['details']['moonsec']['score'] += 25
            result['details']['moonsec']['indicators'].append(
                f"Hex variable chain: {len(hex_vars)} vars"
            )
        
        # Massive string.byte or string.char inline arrays
        sb_count = len(re.findall(r'string\.byte\s*\(', source))
        sc_count = len(re.findall(r'string\.char\s*\(', source))
        if sb_count > 20 or sc_count > 20:
            result['details']['moonsec']['score'] += 20
            result['details']['moonsec']['indicators'].append(
                f"string.byte({sb_count}) / string.char({sc_count}) arrays"
            )
        
        # Prometheus-type localized macro wrappers
        prom_macros = len(re.findall(r'local\s+_\w+\s*=\s*string\.', source))
        if prom_macros > 3:
            result['details']['moonsec']['score'] += 15
            result['details']['moonsec']['indicators'].append(
                "Prometheus-style localized macros"
            )
        
        # IIFE chains for decryption
        iife_count = len(re.findall(r'\(\(function\(\)', source))
        iife_end = len(re.findall(r'end\)\(\)', source))
        if iife_count + iife_end > 10:
            result['details']['moonsec']['score'] += 10
            result['details']['moonsec']['indicators'].append(
                "IIFE chains for decryption"
            )
        
        # --- Moonveil Signatures ---
        # Massive if-elseif dispatch chains
        if_chains = re.findall(
            r'(?:if\s+.*?==\s*\d+\s*then[\s\S]*?elseif\s+.*?==\s*\d+\s*then){5,}',
            source
        )
        if if_chains:
            result['details']['moonveil']['score'] += 30
            result['details']['moonveil']['indicators'].append(
                "Massive if-elseif dispatch chain"
            )
        
        # Dispatch table entries
        dispatch_count = len(re.findall(
            r'\[\s*\d+\s*\]\s*=\s*function\s*\(', source
        ))
        if dispatch_count > 5:
            result['details']['moonveil']['score'] += 20
            result['details']['moonveil']['indicators'].append(
                f"Dispatch table entries: {dispatch_count}"
            )
        
        # State variable arithmetic tracking
        state_arith = len(re.findall(r'(\w+)\s*=\s*\1\s*\+\s*\d+', source))
        if state_arith > 8:
            result['details']['moonveil']['score'] += 15
            result['details']['moonveil']['indicators'].append(
                "State variable arithmetic tracking"
            )
        
        # Garbage table injection detection
        garbage_tables = len(re.findall(
            r"""\[\s*['"][\w]+['"]\s*\]\s*=\s*\{[^}]*\{[^}]*\}[^}]*\}""",
            source
        ))
        if garbage_tables > 3:
            result['details']['moonveil']['score'] += 10
            result['details']['moonveil']['indicators'].append(
                "Garbage table injection detected"
            )
        
        # --- Final Scoring ---
        scores = {
            'Luraph': result['details']['luraph']['score'],
            'MoonSec': result['details']['moonsec']['score'],
            'Moonveil': result['details']['moonveil']['score'],
        }
        
        max_score = max(scores.values())
        if max_score >= 25:
            winner = max(scores, key=scores.get)
            result['protector'] = winner
            result['confidence'] = min(round((max_score / 90) * 100), 95)
        
        return result


