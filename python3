class Layer2Deserializer:
    """
    Extracts and simulates decryption of virtual machine constant tables.
    Targets encrypted strings, integers, and boolean parameters hidden
    within obfuscated byte arrays.
    """
    
    @staticmethod
    def deserialize(source: str, identification: Dict) -> Dict[str, Any]:
        """
        Run protector-specific deserialization.
        
        Args:
            source: Raw Lua source
            identification: Result from Layer 1
            
        Returns:
            Dict with modified source, constants map, and count
        """
        result = {
            'source': source,
            'constants': {},
            'restored': 0,
            'error': None
        }
        
        try:
            protector = identification.get('protector', 'Unknown')
            
            if protector == 'Luraph':
                result = Layer2Deserializer._deserialize_luraph(source)
            elif protector == 'MoonSec':
                result = Layer2Deserializer._deserialize_moonsec(source)
            elif protector == 'Moonveil':
                result = Layer2Deserializer._deserialize_moonveil(source)
            else:
                result = Layer2Deserializer._deserialize_generic(source)
                
        except Exception as e:
            result['error'] = str(e)
            result['source'] = source
        
        return result
    
    @staticmethod
    def _try_xor_decrypt(bytes_list: List[int]) -> Optional[str]:
        """Try XOR decryption with common keys."""
        if not bytes_list:
            return None
        
        # Try single-byte XOR keys
        for key in range(256):
            try:
                decoded = bytes([b ^ key for b in bytes_list])
                decoded_str = decoded.decode('latin-1')
                # Check if result is readable text
                if (re.match(r'^[a-zA-Z0-9_\s\.\,\;\:\!\?\-\+\/\*\(\)\[\]\{\}\'\"]+$', 
                           decoded_str) and len(decoded_str) > 2):
                    return decoded_str
            except:
                continue
        
        # Try XOR with incrementing key (position-based)
        try:
            decoded = bytes([b ^ (i % 256) for i, b in enumerate(bytes_list)])
            decoded_str = decoded.decode('latin-1')
            if re.match(r'^[a-zA-Z0-9_\s\.]+$', decoded_str) and len(decoded_str) > 2:
                return decoded_str
        except:
            pass
        
        return None
    
    @staticmethod
    def _extract_bytes(byte_str: str) -> List[int]:
        """Extract integer bytes from a Lua array string."""
        bytes_list = []
        for part in byte_str.split(','):
            part = part.strip()
            if not part:
                continue
            # Handle inline calculations like 123+45
            if '+' in part or '-' in part:
                try:
                    val = eval(part)
                    bytes_list.append(int(val))
                except:
                    continue
            else:
                try:
                    bytes_list.append(int(part))
                except:
                    continue
        return [b for b in bytes_list if 0 <= b <= 255]
    
    @staticmethod
    def _deserialize_luraph(source: str) -> Dict[str, Any]:
        """Luraph constant decryption simulation."""
        constants = {}
        restored = 0
        modified = source
        
        # Pattern 1: Extract LPH encrypted byte arrays
        # local LPH_X = {byte1, byte2, ...}
        pattern = re.compile(r'local\s+(LPH_\d+)\s*=\s*\{([^}]+)\}')
        for match in pattern.finditer(source):
            var_name = match.group(1)
            bytes_list = Layer2Deserializer._extract_bytes(match.group(2))
            
            if len(bytes_list) > 2:
                decrypted = Layer2Deserializer._try_xor_decrypt(bytes_list)
                if decrypted:
                    constants[var_name] = decrypted
                    restored += 1
                    # Replace references in source
                    modified = re.sub(
                        re.escape(var_name),
                        f'"{decrypted}"',
                        modified
                    )
        
        # Pattern 2: table.concat byte reconstruction
        concat_pattern = re.compile(r'table\.concat\s*\(\s*\{([^}]+)\}\s*\)')
        for match in concat_pattern.finditer(source):
            bytes_list = Layer2Deserializer._extract_bytes(match.group(1))
            printable = [b for b in bytes_list if 32 <= b <= 126]
            if len(printable) > 3:
                try:
                    decoded = bytes(printable).decode('latin-1')
                    constants[f'concat_{restored}'] = decoded
                    restored += 1
                except:
                    pass
        
        return {'source': modified, 'constants': constants, 'restored': restored, 'error': None}
    
    @staticmethod
    def _deserialize_moonsec(source: str) -> Dict[str, Any]:
        """MoonSec constant decryption simulation."""
        constants = {}
        restored = 0
        modified = source
        
        # Pattern 1: Extract hex variable initializations
        hex_vars = {}
        for match in re.finditer(r'_0x([0-9a-fA-F]+)\s*=\s*(\d+)', source):
            hex_vars[f'_0x{match.group(1)}'] = int(match.group(2))
        
        # Pattern 2: Extract string.byte inline arrays
        byte_array_pattern = re.compile(r'\{([^}]*string\.byte[^}]*)\}')
        for match in byte_array_pattern.finditer(source):
            try:
                inner = match.group(1)
                nums = re.findall(r'\d+', inner)
                if len(nums) > 2:
                    bytes_list = [int(n) for n in nums if 32 <= int(n) <= 126]
                    if len(bytes_list) > 2:
                        # Try XOR with keys from hex vars
                        keys = list(hex_vars.values())[:5] or [0, 1, 2]
                        for key in keys:
                            try:
                                decoded = bytes([b ^ ((key + i) % 256) 
                                                for i, b in enumerate(bytes_list)])
                                decoded_str = decoded.decode('latin-1')
                                clean = ''.join(c for c in decoded_str 
                                              if 32 <= ord(c) <= 126)
                                if (len(clean) > 3 and 
                                    re.match(r'^[a-zA-Z0-9_\-\s\.]+$', clean)):
                                    constants[f'moonsec_{restored}'] = clean
                                    restored += 1
                                    break
                            except:
                                continue
            except:
                continue
        
        # Pattern 3: Prometheus-style IIFE string wrappers
        iife_pattern = re.compile(
            r'\(function\s*\([^)]*\)[\s\S]*?end\)\([^)]*\)'
        )
        for match in iife_pattern.finditer(source):
            block = match.group(0)
            for cm in re.finditer(r'string\.char\s*\(([^)]+)\)', block):
                args = re.findall(r'\d+', cm.group(1))
                if len(args) > 2:
                    bytes_list = [int(a) for a in args if 32 <= int(a) <= 126]
                    if len(bytes_list) > 2:
                        try:
                            decoded = bytes(bytes_list).decode('latin-1')
                            constants[f'prometheus_{restored}'] = decoded
                            restored += 1
                        except:
                            continue
        
        return {'source': modified, 'constants': constants, 'restored': restored, 'error': None}
    
    @staticmethod
    def _deserialize_moonveil(source: str) -> Dict[str, Any]:
        """Moonveil constant deserialization."""
        constants = {}
        restored = 0
        modified = source
        
        # Pattern 1: Extract dispatch table string entries
        for match in re.finditer(
            r"""\[\s*(\d+)\s*\]\s*=\s*['"]([^'"]+)['"]""", source
        ):
            key = int(match.group(1))
            val = match.group(2)
            if len(val) > 2:
                constants[f'dispatch_{key}'] = val
                restored += 1
        
        # Pattern 2: Extract encrypted payloads from nested tables
        for match in re.finditer(
            r"""\{['"]([^'"]+)['"]\s*=\s*\{([^}]+)\}\}""", source
        ):
            try:
                key = match.group(1)
                val_content = match.group(2)
                nums = re.findall(r'\d+', val_content)
                if len(nums) > 2:
                    bytes_list = [int(n) for n in nums if 32 <= int(n) <= 126]
                    if len(bytes_list) > 2:
                        decoded = bytes(bytes_list).decode('latin-1')
                        constants[key] = decoded
                        restored += 1
                        modified = modified.replace(
                            match.group(0),
                            f'{{["{key}"]="{decoded}"}}'
                        )
            except:
                continue
        
        # Pattern 3: string.char code construction
        for match in re.finditer(
            r'string\.char\s*\(\s*(\d+(?:\s*,\s*\d+)+)\s*\)', source
        ):
            try:
                bytes_list = [int(n.strip()) for n in match.group(1).split(',')
                             if 32 <= int(n.strip()) <= 126]
                if len(bytes_list) > 2:
                    decoded = bytes(bytes_list).decode('latin-1')
                    constants[f'charcode_{restored}'] = decoded
                    restored += 1
            except:
                continue
        
        return {'source': modified, 'constants': constants, 'restored': restored, 'error': None}
    
    @staticmethod
    def _deserialize_generic(source: str) -> Dict[str, Any]:
        """Generic heuristic deserialization for unknown protectors."""
        constants = {}
        restored = 0
        modified = source
        
        # Find numeric byte arrays that could be strings
        pattern = re.compile(r'\{\s*(\d{2,3}\s*,\s*){3,}\d{2,3}\s*\}')
        for match in pattern.finditer(source):
            try:
                nums = [int(n) for n in re.findall(r'\d+', match.group(0))]
                printable = [b for b in nums if 32 <= b <= 126]
                if len(printable) > 3:
                    decoded = bytes(printable).decode('latin-1')
                    constants[f'generic_{restored}'] = decoded
                    restored += 1
                    modified = modified.replace(match.group(0), f'"{decoded}"')
            except:
                continue
        
        return {'source': modified, 'constants': constants, 'restored': restored, 'error': None}


