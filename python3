class ProtectorIdentifier:
    """Enhanced heuristic scanner for protector detection including Luraph V4."""
    
    # Luraph V4 specific patterns
    LURAPH_V4_PATTERNS = [
        # Anti-tamper via string.dump CRC checks
        (r'string\.dump\s*\([^)]*\)\s*:\s*byte\s*\(', 15, 'string.dump anti-tamper CRC'),
        # debug.getinfo environment checks
        (r'debug\.getinfo\s*\(', 10, 'debug.getinfo environment probe'),
        # getfenv/setfenv proxying
        (r'(?:getfenv|setfenv)\s*\([^)]*\)', 10, 'environment proxy'),
        # V4-style initialization guards
        (r'if\s+not\s+[\w_]+\s+then\s+return\s+end', 12, 'V4 init guard'),
        # V4 nested dispatch tables (empty {} heavily populated)
        (r'local\s+\w+\s*=\s*\{\}\s*[\s\S]*?\1\[\d+\]', 10, 'sequential dispatch population'),
        # CRC comparison patterns
        (r'=\s*0[xX][0-9a-fA-F]{8}', 8, 'hex CRC constant'),
        # Global environment lockdown
        (r'(?:lock|protect|freeze)\([_G]', 8, 'environment lockdown'),
        # V4-specific string table with length prefix
        (r'string\.byte\s*\([^,]+,\s*1,\s*-\s*1\)', 10, 'full-string byte extraction'),
        # Metatable hooking
        (r'getmetatable\s*\([^)]*\)\.__\w+', 8, 'metatable hooking'),
        # Multi-pass XOR with chained byte operations
        (r'bit32?\.(?:bxor|band|bor)\s*\([^)]*\)', 12, 'bit32 multi-pass XOR'),
        # Stack canary / integrity check
        (r'pcall\s*\(\s*function\s*\(\)[\s\S]*?check[\s\S]*?end\s*\)', 10, 'stack canary check'),
    ]
    
    # Luraph V3 (legacy) patterns
    LURAPH_V3_PATTERNS = [
        (r'LPH_\d+\s*=', 25, 'LPH_ globals'),
        (r'LPH_\d+\s*=\s*string\.(?:byte|char|sub|len)\b', 20, 'string aliases'),
        (r'table\.concat\s*\([^)]*byte[^)]*\)', 15, 'byte reconstruction'),
    ]
    
    # MoonSec patterns
    MOONSEC_PATTERNS = [
        (r'_0x[0-9a-fA-F]{2,8}', 25, 'hex variable chain'),
        (r'string\.byte\s*\(', 10, 'string.byte arrays'),
        (r'string\.char\s*\(', 10, 'string.char arrays'),
        (r'local\s+_\w+\s*=\s*string\.', 15, 'localized string macros'),
    ]
    
    # Moonveil patterns
    MOONVEIL_PATTERNS = [
        (r'(?:if\s+.*?==\s*\d+\s*then[\s\S]*?elseif\s+.*?==\s*\d+\s*then){5,}', 
         30, 'if-elseif dispatch chain'),
        (r'\[\s*\d+\s*\]\s*=\s*function\s*\(', 20, 'dispatch entries'),
        (r'(\w+)\s*=\s*\1\s*\+\s*\d+', 8, 'state arithmetic'),
    ]
    
    @classmethod
    def identify(cls, source: str) -> Tuple[str, float, Dict[str, Any]]:
        """Run all detectors and return the best match.
        
        Returns:
            (protector_name, confidence_percent, details_dict)
        """
        details = {
            'Luraph V4': {'score': 0, 'indicators': []},
            'Luraph V3': {'score': 0, 'indicators': []},
            'MoonSec': {'score': 0, 'indicators': []},
            'Moonveil': {'score': 0, 'indicators': []},
        }
        
        if not source or len(source) < 10:
            return ('Unknown', 0.0, details)
        
        # --- Check Luraph V4 ---
        for pattern, weight, desc in cls.LURAPH_V4_PATTERNS:
            matches = len(re.findall(pattern, source, re.DOTALL))
            if matches > 0:
                details['Luraph V4']['score'] += weight * min(matches, 3)
                details['Luraph V4']['indicators'].append(f'{desc} (x{matches})')
        
        # --- Check Luraph V3 ---
        for pattern, weight, desc in cls.LURAPH_V3_PATTERNS:
            matches = len(re.findall(pattern, source))
            if matches > 0:
                details['Luraph V3']['score'] += weight * min(matches, 2)
                details['Luraph V3']['indicators'].append(f'{desc} (x{matches})')
        
        # --- Check MoonSec ---
        for pattern, weight, desc in cls.MOONSEC_PATTERNS:
            matches = len(re.findall(pattern, source))
            if matches > 0:
                details['MoonSec']['score'] += weight * min(matches, 3)
                details['MoonSec']['indicators'].append(f'{desc} (x{matches})')
        
        # --- Check Moonveil ---
        for pattern, weight, desc in cls.MOONVEIL_PATTERNS:
            matches = len(re.findall(pattern, source))
            if matches > 0:
                details['Moonveil']['score'] += weight * min(matches, 3)
                details['Moonveil']['indicators'].append(f'{desc} (x{matches})')
        
        # --- Compute winner ---
        scores = {k: v['score'] for k, v in details.items()}
        max_score = max(scores.values())
        
        if max_score >= 20:
            winner = max(scores, key=scores.get)
            confidence = min(round((max_score / 120) * 100, 1), 96.0)
            return (winner, confidence, details)
        
        # --- Generic fallback heuristics ---
        generic_score = 0
        # High density of escaped strings indicates obfuscation
        esc_strings = len(re.findall(r'\\x[0-9a-fA-F]{2}', source))
        if esc_strings > 20:
            generic_score += 15
        # High comment-to-code ratio
        comments = len(re.findall(r'--\[\[.*?\]\]', source, re.DOTALL))
        if comments > 30:
            generic_score += 10
        
        if generic_score >= 15:
            return ('Generic/Obfuscated', generic_score, details)
        
        return ('Unknown/Clean', 0.0, details)


