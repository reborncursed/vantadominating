class Layer4Formatter:
    """
    Beautifies Lua source and prepends a detailed analysis report header.
    """
    
    @staticmethod
    def format(
        source: str,
        identification: Dict,
        deserialization: Dict,
        devirtualization: Dict
    ) -> str:
        """
        Format deobfuscated source with header report.
        
        Args:
            source: Deobfuscated source code
            identification: Layer 1 results
            deserialization: Layer 2 results
            devirtualization: Layer 3 results
            
        Returns:
            Formatted output with header
        """
        beautified = source
        
        try:
            beautified = Layer4Formatter._beautify_lua(beautified)
        except Exception:
            pass  # Use original if beautification fails
        
        header = Layer4Formatter._build_header(
            identification, deserialization, devirtualization
        )
        
        return header + '\n' + beautified
    
    @staticmethod
    def _build_header(
        identification: Dict,
        deserialization: Dict,
        devirtualization: Dict
    ) -> str:
        """Build ASCII analysis report header."""
        sep = '=' * 72
        
        details = identification.get('details', {})
        scores_str = json.dumps({
            k: v['score'] for k, v in details.items()
        }) if details else 'N/A'
        
        const_count = len(deserialization.get('constants', {}))
        
        header = f"""{sep}
  LUA STATIC ANALYSIS & DEOBFUSCATION REPORT
{sep}

  Protector Detected  : {identification.get('protector', 'Unknown')}
  Confidence          : {identification.get('confidence', 0)}%

  -- Constant Restoration --
  Constants Decrypted : {deserialization.get('restored', 0)}
  Constants Map Size  : {const_count}
  Errors              : {deserialization.get('error', 'None')}

  -- Control Flow Unflattening --
  Dead Code Removed   : {devirtualization.get('dead_code_removed', 0)} bytes
  Loops Simplified    : {devirtualization.get('loops_simplified', 0)}
  Errors              : {devirtualization.get('error', 'None')}

  -- Layer Details --
  L1 (Identification) : {scores_str}
  L2 (Deserialization): {'Map with ' + str(const_count) + ' entries' if const_count > 0 else 'None'}
  L3 (De-virtualize)  : {'{:,} bytes removed, {} loops'.format(
      devirtualization.get('dead_code_removed', 0),
      devirtualization.get('loops_simplified', 0)
  )}

{sep}
  Generated by Lua Static Analysis Engine (Educational)
{sep}"""
        return header
    
    @staticmethod
    def _beautify_lua(source: str) -> str:
        """Basic Lua source beautification with proper indentation."""
        s = source
        
        # Normalize line endings
        s = s.replace('\r\n', '\n')
        
        # Remove excessive blank lines (more than 2 consecutive)
        s = re.sub(r'\n{3,}', '\n\n', s)
        
        # Ensure proper spacing around operators (basic)
        s = re.sub(r'\s*=\s*', ' = ', s)
        s = re.sub(r'\s*\+\s*', ' + ', s)
        s = re.sub(r'\s*-\s*', ' - ', s)
        s = re.sub(r'\s*\*\s*', ' * ', s)
        
        # Ensure proper spacing after commas
        s = re.sub(r',\s*', ', ', s)
        
        # Handle indentation
        lines = s.split('\n')
        indent_level = 0
        beautified_lines = []
        
        indent_keywords = (r'\b(then|do)\s*$', r'^else\s*$', r'\bfunction\s*\(')
        dedent_keywords = (r'^(end|else|elseif|until)\b',)
        
        for line in lines:
            trimmed = line.strip()
            if not trimmed:
                beautified_lines.append('')
                continue
            
            # Decrease indent for end, else, elseif, until
            if any(re.match(pattern, trimmed) for pattern in dedent_keywords):
                indent_level = max(0, indent_level - 1)
            
            indent_str = '  ' * max(0, indent_level)
            beautified_lines.append(indent_str + trimmed)
            
            # Increase indent after then, do, function, else
            if any(re.search(pattern, trimmed) for pattern in indent_keywords) or \
               trimmed == 'else':
                indent_level += 1
        
        s = '\n'.join(beautified_lines)
        
        # Remove trailing whitespace
        s = re.sub(r'[ \t]+$', '', s, flags=re.MULTILINE)
        
        return s


# ======================================================================
# MAIN ENGINE: ORCHESTRATOR
# ======================================================================

class LuaDeobfuscationEngine:
    """
    Main orchestrator that runs the full 4-layer deobfuscation pipeline.
    Each layer is wrapped in try-except to prevent full system crashes.
    """
    
    @staticmethod
    def run(raw_source: str) -> Dict[str, Any]:
        """
        Execute the complete deobfuscation pipeline.
        
        Args:
            raw_source: Raw Lua script source code
            
        Returns:
            Dict with success flag, output string, and logs
        """
        logger = Logger()
        current_source = raw_source
        
        logger.info("=== LUA STATIC ANALYSIS ENGINE START ===")
        logger.info(f"Input size: {len(raw_source)} bytes")
        
        # --- Layer 1: Identification ---
        logger.info("[L1] Running identification pass...")
        try:
            identification = Layer1Identifier.identify(current_source)
            logger.info(
                f"[L1] Protector: {identification['protector']} "
                f"({identification['confidence']}% confidence)"
            )
        except Exception as e:
            logger.error(f"[L1] Identification failed: {e}")
            identification = {
                'protector': 'Unknown',
                'confidence': 0,
                'details': {}
            }
        
        # --- Layer 2: Deserialization ---
        logger.info("[L2] Running deserialization pass...")
        try:
            deserialization = Layer2Deserializer.deserialize(
                current_source, identification
            )
            logger.info(
                f"[L2] Constants restored: {deserialization['restored']}"
            )
            current_source = deserialization['source']
        except Exception as e:
            logger.error(f"[L2] Deserialization failed: {e}")
            deserialization = {
                'source': current_source,
                'constants': {},
                'restored': 0,
                'error': str(e)
            }
        
        # --- Layer 3: De-virtualization ---
        logger.info("[L3] Running de-virtualization pass...")
        try:
            devirtualization = Layer3DeVirtualizer.de_virtualize(current_source)
            logger.info(
                f"[L3] Dead code removed: "
                f"{devirtualization['dead_code_removed']} bytes"
            )
            logger.info(
                f"[L3] Loops simplified: "
                f"{devirtualization['loops_simplified']}"
            )
            current_source = devirtualization['source']
        except Exception as e:
            logger.error(f"[L3] De-virtualization failed: {e}")
            devirtualization = {
                'source': current_source,
                'dead_code_removed': 0,
                'loops_simplified': 0,
                'error': str(e)
            }
        
        # --- Layer 4: Formatting ---
        logger.info("[L4] Running formatting pass...")
        try:
            output = Layer4Formatter.format(
                current_source,
                identification,
                deserialization,
                devirtualization
            )
            logger.info("[L4] Formatting complete")
        except Exception as e:
            logger.error(f"[L4] Formatting failed: {e}")
            output = f"-- [[ L4 Formatting Error: {e} ]]\n" + current_source
        
        logger.info("=== ENGINE COMPLETE ===")
        
        return {
            'success': True,
            'output': output,
            'logs': logger.get_all()
        }


# ======================================================================
# COMMAND-LINE ENTRY POINT
# ======================================================================

def main():
    """
    CLI entry point.
    Usage: python3 thisfile.py < input.lua > output.lua
    """
    try:
        raw_source = sys.stdin.read()
        result = LuaDeobfuscationEngine.run(raw_source)
        print(result['output'])
        print(result['logs'], file=sys.stderr)
    except KeyboardInterrupt:
        sys.exit(1)
    except Exception as e:
        print(f"-- [[ Fatal Error: {e} ]] --", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
