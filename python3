@dataclass
class Token:
    """A single lexical token with source position."""
    type: TokenType
    value: str
    line: int
    col: int
    raw: str = ''


class LuaTokenizer:
    """Stateful Lua source tokenizer.
    
    Produces a stream of Token objects from raw Lua source text.
    Handles strings, comments, numbers, and all Lua syntax.
    """
    
    # Combined regex for tokenization — ordered by priority
    TOKEN_PATTERNS: List[Tuple[str, Optional[TokenType], Callable]] = [
        # Block comments
        (r'--\[\[.*?\]\]', TokenType.BLOCK_COMMENT, None),
        # Line comments (must be after block comments)
        (r'--[^\n]*', TokenType.COMMENT, None),
        # Long strings [[...]]
        (r'\[\[.*?\]\]', TokenType.STRING, None),
        # Quoted strings
        (r'"(?:[^"\\]|\\.)*"', TokenType.STRING, None),
        (r"'(?:[^'\\]|\\.)*'", TokenType.STRING, None),
        # Numbers (float then int)
        (r'\d+\.\d*(?:[eE][+-]?\d+)?', TokenType.NUMBER, None),
        (r'0[xX][0-9a-fA-F]+', TokenType.NUMBER, None),
        (r'\d+', TokenType.NUMBER, None),
        # Multi-char operators
        (r'\.\.\.', TokenType.ELLIPSIS, None),
        (r'\.\.', TokenType.CONCAT, None),
        (r'==', TokenType.EQ, None),
        (r'~=', TokenType.NE, None),
        (r'<=', TokenType.LE, None),
        (r'>=', TokenType.GE, None),
        (r'::', None, None),
        # Single-char operators and delimiters
        (r'=', TokenType.ASSIGN, None),
        (r'\+', TokenType.PLUS, None),
        (r'-', TokenType.MINUS, None),
        (r'\*', TokenType.MUL, None),
        (r'/', TokenType.DIV, None),
        (r'%', TokenType.MOD, None),
        (r'\^', TokenType.POW, None),
        (r'<', TokenType.LT, None),
        (r'>', TokenType.GT, None),
        (r'\(', TokenType.LPAREN, None),
        (r'\)', TokenType.RPAREN, None),
        (r'\[', TokenType.LBRACKET, None),
        (r'\]', TokenType.RBRACKET, None),
        (r'\{', TokenType.LBRACE, None),
        (r'\}', TokenType.RBRACE, None),
        (r',', TokenType.COMMA, None),
        (r';', TokenType.SEMI, None),
        (r':', TokenType.COLON, None),
        (r'\.', TokenType.DOT, None),
        (r'#', TokenType.LEN, None),
        # Identifier or keyword
        (r'[a-zA-Z_][a-zA-Z0-9_]*', TokenType.IDENTIFIER, None),
        # Ellipsis for vararg
        (r'\.\.\.', TokenType.ELLIPSIS, None),
        # Whitespace
        (r'\s+', TokenType.WHITESPACE, None),
        # Newlines
        (r'\n', TokenType.NEWLINE, None),
        # Catch-all for unknown chars
        (r'.', TokenType.UNKNOWN, None),
    ]
    
    # Compile the combined pattern
    _combined_pattern = re.compile(
        '|'.join(f'({p[0]})' for p in TOKEN_PATTERNS)
    )

    def __init__(self, source: str):
        self.source = source
        self.tokens: List[Token] = []
        self._tokenize()
    
    def _resolve_keyword(self, ident: str) -> TokenType:
        """Resolve an identifier to a keyword type if applicable."""
        return KEYWORD_TO_TYPE.get(ident, TokenType.IDENTIFIER)

    def _tokenize(self) -> None:
        """Run the tokenizer over the source string."""
        line = 1
        col = 1
        pos = 0
        
        patterns = [p[0] for p in self.TOKEN_PATTERNS]
        combined = re.compile('|'.join(f'({p})' for p in patterns))
        
        for match in combined.finditer(self.source):
            raw = match.group(0)
            for i, (pattern, token_type, _) in enumerate(self.TOKEN_PATTERNS):
                group = match.group(i + 1)
                if group is not None:
                    # Skip whitespace tokens but track position
                    if token_type == TokenType.WHITESPACE:
                        col += len(raw)
                        break
                    
                    # Determine final type
                    final_type = token_type
                    if final_type == TokenType.IDENTIFIER:
                        final_type = self._resolve_keyword(group)
                    
                    self.tokens.append(Token(
                        type=final_type,
                        value=group,
                        line=line,
                        col=col,
                        raw=raw
                    ))
                    
                    # Update position
                    if raw == '\n':
                        line += 1
                        col = 1
                    else:
                        col += len(raw)
                    break

    def get_tokens(self, skip_whitespace: bool = True) -> List[Token]:
        """Return token list, optionally filtering whitespace."""
        if skip_whitespace:
            return [t for t in self.tokens 
                    if t.type not in (TokenType.WHITESPACE, TokenType.COMMENT, 
                                      TokenType.BLOCK_COMMENT)]
        return self.tokens


class ScopeAnalyzer:
    """Simulates AST variable scope tracking without an external parser.
    
    Maintains a stack of lexical scopes and a symbol table mapping
    variable names to their declared values and reassignment chain.
    """
    
    def __init__(self, tokens: List[Token]):
        self.tokens = tokens
        # Scope stack: each scope is a dict of var_name -> list of values
        self.scope_stack: List[Dict[str, List[Any]]] = [{}]
        # Global symbol table (full history)
        self.symbol_table: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
        self.current_line = 0
        
    def analyze(self) -> Dict[str, List[Dict[str, Any]]]:
        """Run scope analysis over the token stream."""
        i = 0
        while i < len(self.tokens):
            t = self.tokens[i]
            self.current_line = t.line
            
            # Scope entry points
            if t.type in (TokenType.IF, TokenType.WHILE, TokenType.FOR, 
                          TokenType.DO, TokenType.REPEAT):
                self._enter_scope()
            elif t.type == TokenType.FUNCTION:
                # Check if preceded by 'local' 
                if i > 0 and self.tokens[i-1].type == TokenType.LOCAL:
                    self._enter_scope()
                else:
                    self._enter_scope()
            elif t.type == TokenType.END:
                self._exit_scope()
            elif t.type == TokenType.UNTIL:
                # repeat...until ends the repeat scope
                self._exit_scope()
            
            # Local variable declarations
            elif t.type == TokenType.LOCAL:
                vars_declared = self._parse_local_declaration(i)
                i += vars_declared - 1  # Skip ahead
            
            # Track assignments to known variables
            elif t.type == TokenType.IDENTIFIER:
                self._track_assignment(i)
            
            i += 1
        
        return dict(self.symbol_table)
    
    def _enter_scope(self) -> None:
        self.scope_stack.append({})
    
    def _exit_scope(self) -> None:
        if len(self.scope_stack) > 1:
            exited = self.scope_stack.pop()
            # Merge exited locals into parent for upward referencing
            for k, v in exited.items():
                if k in self.scope_stack[-1]:
                    self.scope_stack[-1][k].extend(v)
                else:
                    self.scope_stack[-1][k] = v
    
    def _parse_local_declaration(self, start_idx: int) -> int:
        """Parse a local declaration and track variables.
        
        Returns the number of tokens consumed.
        """
        if start_idx + 1 >= len(self.tokens):
            return 1
        
        next_t = self.tokens[start_idx + 1]
        
        # local function name(...) 
        if next_t.type == TokenType.FUNCTION:
            if start_idx + 2 < len(self.tokens):
                name_t = self.tokens[start_idx + 2]
                if name_t.type == TokenType.IDENTIFIER:
                    self._declare_variable(name_t.value, 'function')
                    return 3
            return 2
        
        # local name = value
        if next_t.type == TokenType.IDENTIFIER:
            var_name = next_t.value
            # Look for assignment
            if start_idx + 2 < len(self.tokens) and self.tokens[start_idx + 2].type == TokenType.ASSIGN:
                # Extract the value expression
                value = self._extract_value_expression(start_idx + 3)
                self._declare_variable(var_name, value)
                return 3 + self._count_expression_tokens(start_idx + 3)
            else:
                self._declare_variable(var_name, None)
                return 2
        
        # local name1, name2 = ...
        if next_t.type == TokenType.IDENTIFIER:
            vars_list = [next_t.value]
            j = start_idx + 2
            while j < len(self.tokens) and self.tokens[j].type == TokenType.COMMA:
                j += 1
                if j < len(self.tokens) and self.tokens[j].type == TokenType.IDENTIFIER:
                    vars_list.append(self.tokens[j].value)
                    j += 1
            
            # Check for assignment
            if j < len(self.tokens) and self.tokens[j].type == TokenType.ASSIGN:
                for var_name in vars_list:
                    self._declare_variable(var_name, 'multi-assign')
            else:
                for var_name in vars_list:
                    self._declare_variable(var_name, None)
            
            return j - start_idx
        
        return 1
    
    def _declare_variable(self, name: str, value: Any) -> None:
        """Declare a variable in the current scope."""
        current_scope = self.scope_stack[-1]
        if name not in current_scope:
            current_scope[name] = []
        current_scope[name].append({
            'value': value,
            'line': self.current_line,
            'scope_depth': len(self.scope_stack)
        })
        self.symbol_table[name].append(current_scope[name][-1])
    
    def _track_assignment(self, idx: int) -> None:
        """Track reassignment to a known variable."""
        name = self.tokens[idx].value
        
        # Check if followed by assignment operator
        if idx + 1 < len(self.tokens) and self.tokens[idx + 1].type == TokenType.ASSIGN:
            # Check if variable exists in any scope
            for scope in reversed(self.scope_stack):
                if name in scope:
                    value = self._extract_value_expression(idx + 2)
                    scope[name].append({
                        'value': value,
                        'line': self.current_line,
                        'scope_depth': len(self.scope_stack),
                        'reassign': True
                    })
                    self.symbol_table[name].append(scope[name][-1])
                    break
    
    def _extract_value_expression(self, start_idx: int) -> Any:
        """Extract a simple value expression from the token stream.
        
        Handles: numbers, strings, booleans, nil, table constructors,
        function calls, and simple arithmetic.
        """
        if start_idx >= len(self.tokens):
            return None
        
        t = self.tokens[start_idx]
        
        if t.type == TokenType.NUMBER:
            return float(t.value) if '.' in t.value else int(t.value)
        elif t.type == TokenType.STRING:
            return t.value[1:-1] if len(t.value) >= 2 else t.value
        elif t.type == TokenType.BOOLEAN:
            return t.value == 'true'
        elif t.type == TokenType.NIL:
            return None
        elif t.type == TokenType.LBRACE:
            # Table constructor — extract key-value pairs
            return self._extract_table(start_idx)
        elif t.type == TokenType.MINUS:
            # Negative number
            if start_idx + 1 < len(self.tokens):
                next_t = self.tokens[start_idx + 1]
                if next_t.type == TokenType.NUMBER:
                    val = float(next_t.value) if '.' in next_t.value else int(next_t.value)
                    return -val
        
        return None
    
    def _extract_table(self, start_idx: int) -> Dict[Any, Any]:
        """Extract a Lua table constructor into a Python dict."""
        result = {}
        if self.tokens[start_idx].type != TokenType.LBRACE:
            return result
        
        i = start_idx + 1
        depth = 1
        
        while i < len(self.tokens) and depth > 0:
            t = self.tokens[i]
            if t.type == TokenType.LBRACE:
                depth += 1
            elif t.type == TokenType.RBRACE:
                depth -= 1
            elif t.type == TokenType.LBRACKET and depth == 1:
                # [key] = value pattern
                key = self._extract_value_expression(i + 1)
                # Find closing bracket and equals
                j = i + 1
                while j < len(self.tokens) and self.tokens[j].type != TokenType.RBRACKET:
                    j += 1
                if j + 1 < len(self.tokens) and self.tokens[j + 1].type == TokenType.ASSIGN:
                    value = self._extract_value_expression(j + 2)
                    result[str(key)] = value
            elif t.type == TokenType.IDENTIFIER and depth == 1:
                # key = value pattern (Lua sugar for string keys)
                if i + 1 < len(self.tokens) and self.tokens[i + 1].type == TokenType.ASSIGN:
                    value = self._extract_value_expression(i + 2)
                    result[t.value] = value
            i += 1
        
        return result
    
    def _count_expression_tokens(self, start_idx: int) -> int:
        """Count how many tokens belong to the expression starting at start_idx."""
        count = 0
        depth_paren = 0
        depth_brace = 0
        depth_bracket = 0
        
        i = start_idx
        while i < len(self.tokens):
            t = self.tokens[i]
            if t.type == TokenType.LPAREN:
                depth_paren += 1
            elif t.type == TokenType.RPAREN:
                depth_paren -= 1
                if depth_paren < 0:
                    break
            elif t.type == TokenType.LBRACE:
                depth_brace += 1
            elif t.type == TokenType.RBRACE:
                depth_brace -= 1
                if depth_brace < 0:
                    break
            elif t.type == TokenType.LBRACKET:
                depth_bracket += 1
            elif t.type == TokenType.RBRACKET:
                depth_bracket -= 1
                if depth_bracket < 0:
                    break
            elif t.type in (TokenType.COMMA, TokenType.SEMI) and depth_paren == 0 and depth_brace == 0:
                break
            elif t.type == TokenType.END:
                break
            elif t.type == TokenType.NEWLINE:
                break
            
            count += 1
            i += 1
        
        return max(count, 1)
    
    def resolve_variable(self, name: str) -> Optional[Any]:
        """Resolve a variable's current value from scope chain."""
        for scope in reversed(self.scope_stack):
            if name in scope and scope[name]:
                return scope[name][-1]['value']
        return None


