# LAYER 4b: PRODUCTION BEAUTIFIER & FORMATTER
# ======================================================================

class LuaBeautifier:
    """Production-grade Lua beautifier with proper syntax-aware indentation."""
    
    # Scope-increasing keywords
    SCOPE_INCREASE = {
        'then', 'do', 'else', 'elseif', 'function', 'repeat',
    }
    
    # Scope-decreasing keywords (start of line)
    SCOPE_DECREASE = {
        'end', 'else', 'elseif', 'until',
    }
    
    # Keywords that should be followed by a space
    SPACE_AFTER = {
        'local', 'function', 'if', 'then', 'else', 'elseif', 
        'while', 'for', 'in', 'repeat', 'until', 'return', 'break',
        'not', 'and', 'or',
    }
    
    # Assignment operators
    ASSIGN_OPS = {'=', '+='}
    
    BINARY_OPS = {'+', '-', '*', '/', '%', '^', '..', '==', '~=', 
                  '<=', '>=', '<', '>', 'and', 'or'}
    
    @classmethod
    def beautify(cls, source: str) -> str:
        """Apply full beautification pipeline."""
        try:
            s = source
            
            # Normalize line endings
            s = s.replace('\r\n', '\n')
            
            # Tokenize for proper formatting
            tokenizer = LuaTokenizer(s)
            tokens = tokenizer.get_tokens(skip_whitespace=False)
            
            # Build formatted output from tokens
            formatted = cls._format_from_tokens(tokens)
            
            return formatted
            
        except Exception:
            # Fallback: basic formatting
            return cls._basic_beautify(source)
    
    @classmethod
    def _format_from_tokens(cls, tokens: List[Token]) -> str:
        """Build formatted output from token stream."""
        lines = []
        current_line = []
        indent = 0
        line_start = True
        last_token_type = None
        
        for i, token in enumerate(tokens):
            # Track scope depth
            if token.type == TokenType.KEYWORD:
                kw = token.value
                if kw in cls.SCOPE_DECREASE and line_start:
                    indent = max(0, indent - 1)
            
            # Handle newlines
            if token.type == TokenType.NEWLINE:
                if current_line:
                    line_text = ''.join(current_line).strip()
                    if line_text:
                        indent_str = '  ' * indent
                        lines.append(indent_str + line_text)
                    current_line = []
                    line_start = True
                continue
            
            # Skip standalone whitespace (we'll add our own)
            if token.type == TokenType.WHITESPACE:
                continue
            
            # Determine spacing before this token
            spacing = ''
            val = token.value
            
            if line_start:
                spacing = ''
                line_start = False
            else:
                # Space after keywords
                if (token.type == TokenType.KEYWORD and 
                    token.value in cls.SPACE_AFTER):
                    spacing = ' '
                # Space around binary operators
                elif token.value in cls.BINARY_OPS:
                    spacing = ' '
                # Space after commas
                elif token.value == ',':
                    spacing = ', '
                    val = ''
                # Space before parentheses for function calls
                elif token.value == '(' and last_token_type == TokenType.IDENTIFIER:
                    spacing = ''
                # Space after assignment
                elif token.value == '=':
                    spacing = ' = '
                    val = ''
                else:
                    spacing = ' '
            
            current_line.append(spacing + val)
            last_token_type = token.type
            
            # Update indent after keywords
            if (token.type == TokenType.KEYWORD and 
                token.value in cls.SCOPE_INCREASE and 
                not line_start):
                # Check if next non-whitespace token isn't 'end'
                next_real = cls._next_real_token(tokens, i + 1)
                if next_real and next_real.value != 'end':
                    indent += 1
        
        # Flush remaining content
        if current_line:
            line_text = ''.join(current_line).strip()
            if line_text:
                indent_str = '  ' * indent
                lines.append(indent_str + line_text)
        
        return '\n'.join(lines)
    
    @classmethod
    def _next_real_token(cls, tokens: List[Token], start: int) -> Optional[Token]:
        """Get the next non-whitespace, non-comment token."""
        for i in range(start, min(start + 10, len(tokens))):
            t = tokens[i]
            if t.type not in (TokenType.WHITESPACE, TokenType.COMMENT, 
                              TokenType.BLOCK_COMMENT, TokenType.NEWLINE):
                return t
        return None
    
    @classmethod
    def _basic_beautify(cls, source: str) -> str:
        """Fallback basic beautification."""
        s = source
        
        # Normalize line endings
        s = s.replace('\r\n', '\n')
        
        # Remove excessive blank lines
        s = re.sub(r'\n{3,}', '\n\n', s)
        
        # Basic operator spacing
        s = re.sub(r'\s*=\s*', ' = ', s)
        s = re.sub(r'\s*\+\s*', ' + ', s)
        s = re.sub(r'\s*-\s*', ' - ', s)
        s = re.sub(r'\s*\*\s*', ' * ', s)
        s = re.sub(r'\s*==\s*', ' == ', s)
        s = re.sub(r'\s*,\s*', ', ', s)
        
        # Handle indentation
        lines = s.split('\n')
        indent_level = 0
        result = []
        
        for line in lines:
            stripped = line.strip()
            if not stripped:
                result.append('')
                continue
            
            # Decrease indent for end/else/elseif/until at line start
            if any(stripped.startswith(kw) for kw in ['end', 'else', 'elseif', 'until']):
                indent_level = max(0, indent_level - 1)
            
            indent_str = '  ' * indent_level
            result.append(indent_str + stripped)
            
            # Increase indent after then/do/function/else/repeat
            if any(stripped.endswith(kw) for kw in ['then', 'do']) or \
               stripped == 'else' or \
               stripped.startswith('function') or \
               stripped == 'repeat':
                indent_level += 1
        
        return '\n'.join(result)


# ======================================================================
# MAIN ENGINE ORCHESTRATOR
# ======================================================================

class LuaDeobfuscationEngine:
    """Production orchestrator chaining all 5 analysis layers.
    
    Every layer is protected by comprehensive try/except blocks.
    On failure, diagnostics are recorded and the best-available
    source is passed forward.
    """
    
    @classmethod
    def run(cls, raw_source: str) -> str:
        """Execute full deobfuscation pipeline.
        
        Args:
            raw_source: Raw Lua source code
            
        Returns:
            Formatted output with analysis header
        """
        # Initialize pipeline result
        result = PipelineResult(source=raw_source)
        
        result.log('Orchestrator', DiagnosticSeverity.INFO,
                   f'Engine started. Input: {len(raw_source):,} bytes')
        
        # =================================================================
        # LAYER 1: TOKENIZATION & SCOPE ANALYSIS
        # =================================================================
        result.log('L1-Tokenizer', DiagnosticSeverity.INFO, 'Tokenizing source...')
        try:
            tokenizer = LuaTokenizer(raw_source)
            result.tokens = tokenizer.get_tokens()
            result.log('L1-Tokenizer', DiagnosticSeverity.INFO,
                       f'Produced {len(result.tokens)} tokens')
            
            # Run scope analysis
            analyzer = ScopeAnalyzer(result.tokens)
            result.scope_table = analyzer.analyze()
            scope_count = sum(len(v) for v in result.scope_table.values())
            result.log('L1-Scope', DiagnosticSeverity.INFO,
                       f'Tracked {len(result.scope_table)} variables across scopes')
            
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L1-Tokenizer', DiagnosticSeverity.ERROR,
                       f'Tokenization failed: {e}', tb=tb)
        
        # =================================================================
        # LAYER 2: PROTECTOR IDENTIFICATION
        # =================================================================
        result.log('L2-Identifier', DiagnosticSeverity.INFO, 
                   'Running protector identification...')
        try:
            protector, confidence, details = ProtectorIdentifier.identify(result.source)
            result.protector = protector
            result.confidence = confidence
            
            # Log which indicators fired
            for family, info in details.items():
                if info['score'] > 0:
                    for indicator in info['indicators'][:5]:
                        result.log('L2-Identifier', DiagnosticSeverity.INFO,
                                   f'  [{family}] {indicator}')
            
            result.log('L2-Identifier', DiagnosticSeverity.INFO,
                       f'Detected: {protector} ({confidence:.1f}% confidence)')
            
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L2-Identifier', DiagnosticSeverity.ERROR,
                       f'Identification failed: {e}', tb=tb)
        
        # =================================================================
        # LAYER 3: CONSTANT DESERIALIZATION
        # =================================================================
        result.log('L3-Deserializer', DiagnosticSeverity.INFO,
                   'Running constant deserialization...')
        result = ConstantDeserializer.deserialize(result)
        result.log('L3-Deserializer', DiagnosticSeverity.INFO,
                   f'Decrypted {result.constants_decrypted} constants')
        
        # =================================================================
        # LAYER 4: CONTROL FLOW UNROLLING
        # =================================================================
        result.log('L4-Unroller', DiagnosticSeverity.INFO,
                   'Running control flow unrolling...')
        result = ControlFlowUnroller.unroll(result)
        result.log('L4-Unroller', DiagnosticSeverity.INFO,
                   f'Removed {result.dead_code_bytes:,} dead code bytes, '
                   f'unrolled {result.loops_unrolled} dispatch loops')
        
        # =================================================================
        # LAYER 5: BEAUTIFICATION & OUTPUT
        # =================================================================
        result.log('L5-Beautifier', DiagnosticSeverity.INFO,
                   'Running beautification...')
        try:
            result.source = LuaBeautifier.beautify(result.source)
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L5-Beautifier', DiagnosticSeverity.WARN,
                       f'Beautification fell back: {e}', tb=tb)
            result.source = LuaBeautifier._basic_beautify(result.source)
        
        # Build final output
        result.log('Orchestrator', DiagnosticSeverity.INFO, 'Pipeline complete')
        return result.to_final_output()


# ======================================================================
# COMMAND-LINE ENTRY POINT
# ======================================================================

def main():
    """CLI entry point: reads stdin, writes deobfuscated output to stdout."""
    try:
        raw_source = sys.stdin.read()
        output = LuaDeobfuscationEngine.run(raw_source)
        print(output)
    except KeyboardInterrupt:
        sys.exit(1)
    except Exception as e:
        print(f"-- [[ Fatal Error: {e} ]] --", file=sys.stderr)
        traceback.print_exc(file=sys.stderr)
        # Still try to output the original source as fallback
        if 'raw_source' in dir():
            print(raw_source)
        sys.exit(1)


if __name__ == '__main__':
    main()
