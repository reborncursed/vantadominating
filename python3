# LAYER 4: DEEP-DIVE CONTROL FLOW UNFLATTENING
# ======================================================================

class ControlFlowUnroller:
    """Deep-dive dispatch loop unroller with state transition graph tracking.
    
    Identifies VM dispatch loops, traces state variable assignments,
    builds a directed transition graph, and unrolls blocks in 
    execution order.
    """
    
    @staticmethod
    def unroll(result: PipelineResult) -> PipelineResult:
        """Run the full control flow unrolling pipeline."""
        try:
            source = result.source
            
            # Pass 1: Strip anti-decompiler garbage
            source, removed = ControlFlowUnroller._strip_dead_code(source)
            result.dead_code_bytes += removed
            
            # Pass 2: Find and unroll dispatch loops
            source, unrolled, transitions = ControlFlowUnroller._unroll_dispatch_loops(source)
            result.loops_unrolled += unrolled
            result.state_transitions.extend(transitions)
            
            # Pass 3: Simplify proxy functions
            source = ControlFlowUnroller._inline_proxies(source)
            
            # Pass 4: Clean up nested empty blocks
            source = ControlFlowUnroller._cleanup_nested_blocks(source)
            
            result.source = source
            
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L4-Unroller', DiagnosticSeverity.ERROR,
                       f'Control flow unrolling failed: {e}', tb=tb)
        
        return result
    
    @staticmethod
    def _strip_dead_code(source: str) -> Tuple[str, int]:
        """Remove anti-decompiler dead code and garbage."""
        removed = 0
        modified = source
        
        # Remove nested empty block comments
        orig = len(modified)
        modified = re.sub(r'--\[\[\s*\]\]', '', modified)
        modified = re.sub(r'--\[\[\s*--\s*\]\]', '', modified)
        removed += orig - len(modified)
        
        # Remove `if false then ... end` blocks (never executed)
        orig = len(modified)
        # Handle nested blocks carefully
        modified = re.sub(
            r'if\s+false\s+then\s*(?:(?!\bend\b).)*\bend\b',
            '',
            modified,
            flags=re.DOTALL
        )
        removed += orig - len(modified)
        
        # Evaluate static conditions `if X == Y then`
        def eval_static_if(match):
            body = match.group(1)
            cond_match = re.match(r'if\s+(\d+)\s*==\s*(\d+)\s*then', match.group(0))
            if cond_match:
                a, b = int(cond_match.group(1)), int(cond_match.group(2))
                if a == b:
                    return body.strip()  # Unwrap (always true)
                else:
                    return ''  # Remove (always false)
            return match.group(0)
        
        modified = re.sub(
            r'if\s+\d+\s*==\s*\d+\s*then\s*([\s\S]*?)\bend\b',
            eval_static_if,
            modified
        )
        
        # Remove `while false do ... end`
        orig = len(modified)
        modified = re.sub(r'while\s+false\s+do[\s\S]*?\bend\b', '', modified)
        removed += orig - len(modified)
        
        # Remove garbage table injections
        orig = len(modified)
        garbage_pattern = re.compile(
            r"""\[\s*['"][\w]+['"]\s*\]\s*=\s*\{[^}]*\{[^}]*\}[^}]*\},?"""
        )
        modified = garbage_pattern.sub('', modified)
        removed += orig - len(modified)
        
        return modified, removed
    
    @staticmethod
    def _unroll_dispatch_loops(source: str) -> Tuple[str, int, List[Tuple[int, int]]]:
        """Deep-dive dispatch loop unrolling with transition graph."""
        unrolled_count = 0
        all_transitions: List[Tuple[int, int]] = []
        
        # Find while/repeat dispatch loops
        # Pattern: while true/1 do ... end with if/elseif state chains
        def unroll_while_match(match):
            nonlocal unrolled_count, all_transitions
            body = match.group(1)
            
            # Step 1: Identify state variable and extract state blocks
            state_blocks = ControlFlowUnroller._extract_state_blocks(body)
            if not state_blocks or len(state_blocks) < 3:
                return match.group(0)  # Not a dispatch loop
            
            # Step 2: Build state transition graph
            transitions, state_var = ControlFlowUnroller._build_transition_graph(
                body, state_blocks
            )
            
            if not transitions:
                return match.group(0)
            
            all_transitions.extend(transitions)
            
            # Step 3: Find initial state (pre-loop)
            pre_loop = match.group(0)
            initial_state_match = re.search(
                re.escape(state_var) + r'\s*=\s*(\d+)',
                source[:match.start()]
            )
            if initial_state_match:
                initial_state = int(initial_state_match.group(1))
            else:
                # Guess: first state in the chain
                initial_state = min(sb['state'] for sb in state_blocks)
            
            # Step 4: Traverse the graph in execution order
            sorted_blocks = ControlFlowUnroller._traverse_transition_graph(
                state_blocks, transitions, initial_state
            )
            
            if not sorted_blocks:
                return match.group(0)
            
            unrolled_count += 1
            
            # Step 5: Generate unrolled code
            parts = []
            for i, block in enumerate(sorted_blocks):
                clean_code = ControlFlowUnroller._clean_state_block(
                    block['code'], state_var
                )
                parts.append(f"-- [[ State {block['state']} ({i+1}/{len(sorted_blocks)}) ]]\n{clean_code}")
            
            return '\n'.join(parts)
        
        # Process while loops
        while_pattern = re.compile(
            r'while\s+(?:true|1)\s+do\s*([\s\S]*?)\bend\b'
        )
        modified = while_pattern.sub(unroll_while_match, source)
        
        # Process repeat loops
        repeat_pattern = re.compile(
            r'repeat\s*([\s\S]*?)\buntil\b'
        )
        modified = repeat_pattern.sub(unroll_while_match, modified)
        
        return modified, unrolled_count, all_transitions
    
    @staticmethod
    def _extract_state_blocks(body: str) -> List[Dict[str, Any]]:
        """Extract state blocks from a dispatch loop body.
        
        Handles both static (state_var == N) and dynamic 
        (state_var = N) state transitions.
        """
        blocks = []
        
        # Method 1: Extract from if/elseif chains (static dispatch)
        if_pattern = re.compile(
            r'(?:if|elseif)\s+(\w+)\s*==\s*(\d+)\s*then\s*([\s\S]*?)(?=elseif|\bend\b)'
        )
        for match in if_pattern.finditer(body):
            blocks.append({
                'state': int(match.group(2)),
                'var': match.group(1),
                'code': match.group(3).strip(),
                'type': 'static'
            })
        
        # Method 2: Extract from inline state assignments (dynamic dispatch)
        # Pattern: do block end where state is set
        if not blocks:
            state_pattern = re.compile(
                r'(\w+)\s*=\s*(\d+)\s*[\s\S]*?(?=\1\s*=\s*\d+|$)'
            )
            for match in state_pattern.finditer(body):
                # Find the containing block
                block_match = re.search(
                    r'(?:do|then)\s*([\s\S]*?)\bend\b',
                    body[match.start():]
                )
                if block_match:
                    blocks.append({
                        'state': int(match.group(2)),
                        'var': match.group(1),
                        'code': block_match.group(1).strip(),
                        'type': 'dynamic'
                    })
        
        # Deduplicate by state number
        seen_states = set()
        unique_blocks = []
        for block in blocks:
            if block['state'] not in seen_states:
                seen_states.add(block['state'])
                unique_blocks.append(block)
        
        return sorted(unique_blocks, key=lambda b: b['state'])
    
    @staticmethod
    def _build_transition_graph(
        body: str, state_blocks: List[Dict[str, Any]]
    ) -> Tuple[List[Tuple[int, int]], str]:
        """Build state transition graph from dispatch loop body.
        
        Returns:
            (transitions_list, state_variable_name)
        """
        transitions: List[Tuple[int, int]] = []
        
        if not state_blocks:
            return transitions, ''
        
        state_var = state_blocks[0]['var']
        
        for block in state_blocks:
            # Look for state variable reassignment within each block
            # Pattern: state_var = N
            assign_pattern = re.compile(
                re.escape(state_var) + r'\s*=\s*(\d+)'
            )
            for assign_match in assign_pattern.finditer(block['code']):
                next_state = int(assign_match.group(1))
                transitions.append((block['state'], next_state))
            
            # Also look for computed transitions like state_var = state_var + N
            computed_pattern = re.compile(
                re.escape(state_var) + r'\s*=\s*(?:\w+\s*\+\s*(\d+)|\d+\s*\+\s*\w+)'
            )
            for comp_match in computed_pattern.finditer(block['code']):
                # Conservative: add edge to state+N
                if comp_match.group(1):
                    delta = int(comp_match.group(1))
                    transitions.append((block['state'], block['state'] + delta))
        
        # If no explicit transitions found, infer sequential transitions
        if not transitions and len(state_blocks) > 1:
            for i in range(len(state_blocks) - 1):
                transitions.append((state_blocks[i]['state'], state_blocks[i + 1]['state']))
            # Last state loops back to first (typical VM dispatch)
            transitions.append((state_blocks[-1]['state'], state_blocks[0]['state']))
        
        return transitions, state_var
    
    @staticmethod
    def _traverse_transition_graph(
        state_blocks: List[Dict[str, Any]],
        transitions: List[Tuple[int, int]],
        initial_state: int
    ) -> List[Dict[str, Any]]:
        """Traverse the transition graph from initial state to build execution order.
        
        Uses DFS with cycle detection to handle looping dispatch.
        """
        block_map = {b['state']: b for b in state_blocks}
        
        # Build adjacency list
        adj = defaultdict(list)
        for src, dst in transitions:
            adj[src].append(dst)
        
        # Traverse from initial state
        visited = set()
        execution_order: List[Dict[str, Any]] = []
        
        def dfs(state: int, depth: int = 0):
            if depth > 50:  # Safety limit
                return
            if state in visited:
                # Allow one revisit for loop closure
                if state in [b['state'] for b in execution_order]:
                    return
            if state not in block_map:
                return
            
            visited.add(state)
            
            if state in block_map:
                execution_order.append(block_map[state])
            
            for next_state in adj.get(state, []):
                dfs(next_state, depth + 1)
        
        dfs(initial_state)
        
        # If we couldn't traverse (no transitions found), use sequential order
        if not execution_order:
            return sorted(state_blocks, key=lambda b: b['state'])
        
        return execution_order
    
    @staticmethod
    def _clean_state_block(code: str, state_var: str) -> str:
        """Clean a state block by removing state variable assignments and breaks."""
        # Remove state variable assignments
        clean = re.sub(
            re.escape(state_var) + r'\s*=\s*[^;\n]+[;\n]?',
            '',
            code
        )
        # Remove break statements (they break out of the unrolled loop)
        clean = re.sub(r'\bbreak\b\s*', '', clean)
        # Remove redundant empty lines
        clean = re.sub(r'\n\s*\n', '\n', clean)
        return clean.strip()
    
    @staticmethod
    def _inline_proxies(source: str) -> str:
        """Inline short proxy functions.
        
        Pattern: local f = function(x) return x end
        """
        modified = source
        
        # Find and inline proxy functions
        proxy_pattern = re.compile(
            r'local\s+(\w+)\s*=\s*function\s*\((\w+)\)\s*return\s*\2\s*end\s*'
        )
        proxies = {}
        for match in proxy_pattern.finditer(modified):
            proxies[match.group(1)] = match.group(2)
        
        # Remove definitions
        modified = proxy_pattern.sub('', modified)
        
        # Replace calls
        for fn_name, param_name in proxies.items():
            call_pattern = re.compile(
                re.escape(fn_name) + r'\s*\(\s*([^)]+)\s*\)'
            )
            modified = call_pattern.sub(r'\1', modified)
        
        # Also handle simple arithmetic proxy functions
        proxy_arith = re.compile(
            r'local\s+(\w+)\s*=\s*function\s*\((\w+)\)\s*return\s*\2\s*[\+\-\*\/]\s*(\d+)\s*end\s*'
        )
        arith_proxies = []
        for match in proxy_arith.finditer(modified):
            arith_proxies.append((match.group(1), match.group(2), match.group(3)))
        
        modified = proxy_arith.sub('', modified)
        
        for fn_name, param_name, num in arith_proxies:
            call_pattern = re.compile(
                re.escape(fn_name) + r'\s*\(\s*([^)]+)\s*\)'
            )
            modified = call_pattern.sub(r'(\1 ' + ('+' if '+' in str else '-') + r' ' + num + ')', modified)
        
        return modified
    
    @staticmethod
    def _cleanup_nested_blocks(source: str) -> str:
        """Clean up residual artifacts from unrolling."""
        modified = source
        
        # Remove empty do...end blocks
        modified = re.sub(r'do\s*\bend\b', '', modified)
        
        # Remove empty then...end blocks
        modified = re.sub(r'then\s*\bend\b', '', modified)
        
        # Collapse repeated blank lines
        modified = re.sub(r'\n{3,}', '\n\n', modified)
        
        return modified


