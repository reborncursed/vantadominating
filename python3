# LAYER 3: DE-VIRTUALIZATION & CONTROL FLOW UNFLATTENING
# ======================================================================

class Layer3DeVirtualizer:
    """
    Strips anti-decompiler tricks and simplifies VM dispatch loops.
    Removes dead code, garbage tables, empty comments, and unrolls
    flattened control flow.
    """
    
    @staticmethod
    def de_virtualize(source: str) -> Dict[str, Any]:
        """
        Run de-virtualization passes on the source.
        
        Args:
            source: Partially deobfuscated Lua source
            
        Returns:
            Dict with cleaned source, statistics
        """
        modified = source
        dead_code_removed = 0
        loops_simplified = 0
        error = None
        
        try:
            # --- Pass 1: Remove nested empty comments ---
            orig_len = len(modified)
            modified = re.sub(r'--\[\[[\s]*\]\]', '', modified)
            modified = re.sub(r'--\[\[[\s]*--[\s]*\]\]', '', modified)
            dead_code_removed += orig_len - len(modified)
            
            # --- Pass 2: Remove dead-code blocks ---
            # if true then (always executes - strip wrapper)
            modified = re.sub(r'if\s+true\s+then\s*', '', modified)
            modified = re.sub(r'\s*end\s*--\s*dead\s+code', '', modified)
            
            # if false then ... end (never executes)
            orig_len = len(modified)
            modified = re.sub(
                r'if\s+false\s+then[\s\S]*?end\s*', 
                '', 
                modified
            )
            dead_code_removed += orig_len - len(modified)
            
            # if X == Y then (evaluate constant conditions)
            def resolve_constant_if(match):
                body = match.group(1)
                condition = re.match(
                    r'if\s+(\d+)\s*==\s*(\d+)\s*then', match.group(0)
                )
                if condition:
                    a, b = int(condition.group(1)), int(condition.group(2))
                    if a == b:
                        return body.strip()  # Always true - unwrap
                    else:
                        return ''  # Always false - remove
                return match.group(0)
            
            modified = re.sub(
                r'if\s+\d+\s*==\s*\d+\s*then\s*([\s\S]*?)end\s*',
                resolve_constant_if,
                modified
            )
            
            # --- Pass 3: Remove garbage table injections ---
            orig_len = len(modified)
            garbage_pattern = re.compile(
                r"""\[\s*['"][\w]+['"]\s*\]\s*=\s*\{[^}]*\{[^}]*\}[^}]*\},?\s*"""
            )
            modified = garbage_pattern.sub('', modified)
            dead_code_removed += orig_len - len(modified)
            
            # --- Pass 4: Simplify while-true dispatch loops ---
            def unroll_dispatch(match):
                body = match.group(1)
                # Check if this is a dispatch loop
                state_matches = re.findall(r'(\w+)\s*==\s*(\d+)', body)
                if len(state_matches) > 3:
                    # Extract state transitions
                    transitions = []
                    state_pattern = re.compile(
                        r'(\w+)\s*==\s*(\d+)\s*then\s*([\s\S]*?)(?=elseif|\s*end)'
                    )
                    for sm in state_pattern.finditer(body):
                        transitions.append({
                            'state': int(sm.group(2)),
                            'var': sm.group(1),
                            'code': sm.group(3).strip()
                        })
                    
                    if transitions:
                        # Sort by state number
                        transitions.sort(key=lambda t: t['state'])
                        # Unroll
                        parts = []
                        for t in transitions:
                            clean_code = re.sub(
                                re.escape(t['var']) + r'\s*=\s*\d+\s*',
                                '',
                                t['code']
                            )
                            clean_code = re.sub(r'\bbreak\b', '', clean_code)
                            parts.append(f"-- [[ State {t['state']} ]]\n{clean_code}")
                        return '\n'.join(parts)
                return match.group(0)
            
            while_pattern = re.compile(
                r'while\s+(?:true|1)\s+do\s*([\s\S]*?)end\s*'
            )
            modified = while_pattern.sub(unroll_dispatch, modified)
            
            # Count simplified loops
            loops_simplified = len(re.findall(
                r'-- \[\[ State \d+ \]\]', modified
            ))
            
            # --- Pass 5: Inline short proxy functions ---
            # local f = function(x) return x end
            proxy_pattern = re.compile(
                r'local\s+(\w+)\s*=\s*function\s*\((\w+)\)\s*return\s*\2\s*end\s*'
            )
            proxies = {}
            for pm in proxy_pattern.finditer(modified):
                proxies[pm.group(1)] = pm.group(2)
            
            # Remove proxy definitions
            modified = proxy_pattern.sub('', modified)
            
            # Replace proxy calls
            for fn_name, param_name in proxies.items():
                call_pattern = re.compile(
                    re.escape(fn_name) + r'\s*\(\s*([^)]+)\s*\)'
                )
                modified = call_pattern.sub(r'\1', modified)
            
            # --- Pass 6: Remove while false do ... end ---
            modified = re.sub(r'while\s+false\s+do[\s\S]*?end\s*', '', modified)
            
            # Remove unreachable after unconditional returns
            # (Simplified - full analysis would need AST)
            
        except Exception as e:
            error = str(e)
        
        return {
            'source': modified,
            'dead_code_removed': dead_code_removed,
            'loops_simplified': loops_simplified,
            'error': error
        }


