class ConstantDeserializer:
    """Extracts and decrypts VM constant tables using scope-aware parsing."""
    
    @staticmethod
    def deserialize(result: PipelineResult) -> PipelineResult:
        """Run constant deserialization pipeline."""
        try:
            # Tokenize if not already done
            if not result.tokens:
                tokenizer = LuaTokenizer(result.source)
                result.tokens = tokenizer.get_tokens()
            
            # Run scope analysis
            analyzer = ScopeAnalyzer(result.tokens)
            result.scope_table = analyzer.analyze()
            
            # Run protector-specific deserialization
            if 'Luraph' in result.protector:
                result = ConstantDeserializer._deserialize_luraph(result)
            elif 'MoonSec' in result.protector:
                result = ConstantDeserializer._deserialize_moonsec(result)
            elif 'Moonveil' in result.protector:
                result = ConstantDeserializer._deserialize_moonveil(result)
            else:
                result = ConstantDeserializer._deserialize_generic(result)
                
        except Exception as e:
            tb = traceback.format_exc()
            result.log('L3-Deserializer', DiagnosticSeverity.ERROR,
                       f'Deserialization failed: {e}', tb=tb)
        
        return result
    
    @staticmethod
    def _try_decrypt(bytes_list: List[int]) -> Optional[str]:
        """Try multiple decryption strategies on a byte list."""
        if not bytes_list or len(bytes_list) < 2:
            return None
        
        # Strategy 1: Raw ASCII
        try:
            decoded = bytes(bytes_list).decode('latin-1')
            if decoded.isprintable() and len(decoded) > 2:
                return decoded
        except:
            pass
        
        # Strategy 2: Single-byte XOR (0-255)
        for key in range(256):
            try:
                decoded = bytes(b ^ key for b in bytes_list).decode('latin-1')
                if (re.match(r'^[\x20-\x7E]+$', decoded) and 
                    len(decoded) > 3 and
                    any(c.isalpha() for c in decoded)):
                    return decoded
            except:
                continue
        
        # Strategy 3: Position-based XOR
        for base_key in [0, 1, 2, 5, 13, 42, 128, 255]:
            try:
                decoded = bytes(b ^ ((base_key + i) % 256) 
                              for i, b in enumerate(bytes_list)).decode('latin-1')
                if (re.match(r'^[\x20-\x7E]+$', decoded) and 
                    len(decoded) > 3 and
                    any(c.isalpha() for c in decoded)):
                    return decoded
            except:
                continue
        
        # Strategy 4: XOR with Fibonacci-like sequence
        try:
            fib_key = [0xAA, 0xBB, 0xCC]
            decoded = bytes(b ^ fib_key[i % len(fib_key)] 
                          for i, b in enumerate(bytes_list)).decode('latin-1')
            if (re.match(r'^[\x20-\x7E]+$', decoded) and 
                len(decoded) > 3 and
                any(c.isalpha() for c in decoded)):
                return decoded
        except:
            pass
        
        # Strategy 5: Subtraction-based (common in MoonSec)
        try:
            base = bytes_list[0] if bytes_list[0] < 128 else 256
            decoded = bytes(abs((b - i) % 256) for i, b in enumerate(bytes_list))
            decoded_str = decoded.decode('latin-1', errors='ignore')
            if (re.match(r'^[\x20-\x7E]+$', decoded_str) and 
                len(decoded_str) > 3):
                return decoded_str
        except:
            pass
        
        return None
    
    @staticmethod
    def _extract_bytes_from_array(source: str, start_pos: int) -> Tuple[List[int], int]:
        """Extract integer bytes from a Lua table literal starting at start_pos.
        
        Returns:
            (bytes_list, end_position)
        """
        if source[start_pos] != '{':
            return [], start_pos
        
        bytes_list = []
        depth = 1
        i = start_pos + 1
        
        current_num = ''
        while i < len(source) and depth > 0:
            ch = source[i]
            if ch == '{':
                depth += 1
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    if current_num.strip():
                        try:
                            val = eval(current_num.strip())
                            if isinstance(val, (int, float)):
                                bytes_list.append(int(val) & 0xFF)
                        except:
                            pass
                    break
                if current_num.strip():
                    try:
                        val = eval(current_num.strip())
                        if isinstance(val, (int, float)):
                            bytes_list.append(int(val) & 0xFF)
                    except:
                        pass
                    current_num = ''
            elif ch == ',':
                if current_num.strip():
                    try:
                        val = eval(current_num.strip())
                        if isinstance(val, (int, float)):
                            bytes_list.append(int(val) & 0xFF)
                    except:
                        pass
                    current_num = ''
            elif ch in '+-*/%':
                current_num += ch
            elif ch.isdigit() or ch in 'xXabcdefABCDEF':
                current_num += ch
            elif ch == ' ' or ch == '\t':
                pass  # skip whitespace
            else:
                current_num += ch
            i += 1
        
        return bytes_list, i + 1
    
    @staticmethod
    def _deserialize_luraph(result: PipelineResult) -> PipelineResult:
        """Luraph-specific deserialization."""
        source = result.source
        constants = {}
        restored = 0
        
        # Pattern 1: LPH byte arrays
        for match in re.finditer(r'local\s+(LPH_\d+)\s*=\s*\{', source):
            var_name = match.group(1)
            start = match.end() - 1  # position of '{'
            bytes_list, _ = ConstantDeserializer._extract_bytes_from_array(source, start)
            
            if len(bytes_list) > 3:
                decrypted = ConstantDeserializer._try_decrypt(bytes_list)
                if decrypted:
                    constants[var_name] = decrypted
                    restored += 1
                    result.log('L3-Deserializer', DiagnosticSeverity.INFO,
                               f"Decrypted LPH constant: {var_name} -> '{decrypted[:40]}'")
        
        # Pattern 2: Luraph V4 — multi-pass XOR with bit32
        v4_pattern = re.compile(
            r'bit32?\.bxor\s*\(\s*(\w+)\s*,\s*(\d+)\s*\)'
        )
        for match in v4_pattern.finditer(source):
            var_name = match.group(1)
            xor_key = int(match.group(2))
            
            # Look up the variable in scope table
            if var_name in result.scope_table:
                entries = result.scope_table[var_name]
                for entry in entries:
                    if entry['value'] is not None and isinstance(entry['value'], int):
                        decrypted_val = entry['value'] ^ xor_key
                        # Check if it's a character code
                        if 32 <= decrypted_val <= 126:
                            char = chr(decrypted_val)
                            constants[f'bxor_{var_name}'] = char
                            restored += 1
        
        # Pattern 3: table.concat byte arrays
        for match in re.finditer(r'table\.concat\s*\(\s*\{([^}]+)\}\s*\)', source):
            content = match.group(1)
            nums = re.findall(r'\d+', content)
            bytes_list = [int(n) & 0xFF for n in nums if n.strip()]
            if len(bytes_list) > 3:
                decrypted = ConstantDeserializer._try_decrypt(bytes_list)
                if decrypted:
                    constants[f'concat_{restored}'] = decrypted
                    restored += 1
        
        # Apply replacements to source
        modified = source
        for var_name, decrypted in constants.items():
            if var_name.startswith('LPH_'):
                modified = modified.replace(var_name, f'"{decrypted}"')
        
        result.source = modified
        result.constants_decrypted = restored
        result.constant_map = constants
        return result
    
    @staticmethod
    def _deserialize_moonsec(result: PipelineResult) -> PipelineResult:
        """MoonSec-specific deserialization."""
        source = result.source
        constants = {}
        restored = 0
        
        # Pattern 1: Hex variable chain values
        hex_vars = {}
        for match in re.finditer(r'_0x([0-9a-fA-F]+)\s*=\s*(\d+)', source):
            hex_vars[f'_0x{match.group(1)}'] = int(match.group(2))
        
        # Pattern 2: string.byte inline arrays
        for match in re.finditer(r'\{([^}]*string\.byte[^}]*)\}', source):
            nums = re.findall(r'\d+', match.group(1))
            bytes_list = [int(n) & 0xFF for n in nums if n.strip()]
            if len(bytes_list) > 3:
                # Try XOR with hex var values as keys
                for key in list(hex_vars.values())[:5] + [0, 1, 2, 255]:
                    test_bytes = [b ^ ((key + i) % 256) for i, b in enumerate(bytes_list)]
                    try:
                        decoded = bytes(test_bytes).decode('latin-1')
                        if (re.match(r'^[\x20-\x7E]+$', decoded) and 
                            len(decoded) > 3 and decoded.isprintable()):
                            constants[f'ms_{restored}'] = decoded
                            restored += 1
                            break
                    except:
                        continue
        
        # Pattern 3: Prometheus-style IIFE string chunks
        for match in re.finditer(r'\(function\s*\([^)]*\)[\s\S]*?end\)\([^)]*\)', source):
            block = match.group(0)
            for cm in re.finditer(r'string\.char\s*\(([^)]+)\)', block):
                nums = re.findall(r'\d+', cm.group(1))
                bytes_list = [int(n) & 0xFF for n in nums if 32 <= int(n) <= 126]
                if len(bytes_list) > 2:
                    try:
                        decoded = bytes(bytes_list).decode('latin-1')
                        constants[f'prom_{restored}'] = decoded
                        restored += 1
                    except:
                        continue
        
        result.constants_decrypted = restored
        result.constant_map = constants
        return result
    
    @staticmethod
    def _deserialize_moonveil(result: PipelineResult) -> PipelineResult:
        """Moonveil-specific deserialization."""
        source = result.source
        constants = {}
        restored = 0
        
        # Pattern 1: Dispatch table string entries
        for match in re.finditer(
            r"""\[\s*(\d+)\s*\]\s*=\s*['"]([^'"]+)['"]""", source
        ):
            key = int(match.group(1))
            val = match.group(2)
            if len(val) >= 2:
                constants[f'dispatch_{key}'] = val
                restored += 1
        
        # Pattern 2: Nested table payloads
        for match in re.finditer(
            r"""\{['"]([^'"]+)['"]\s*=\s*\{([^}]+)\}\}""", source
        ):
            try:
                key = match.group(1)
                val_content = match.group(2)
                nums = re.findall(r'\d+', val_content)
                bytes_list = [int(n) & 0xFF for n in nums if 32 <= int(n) <= 126]
                if len(bytes_list) > 3:
                    decoded = bytes(bytes_list).decode('latin-1')
                    constants[key] = decoded
                    restored += 1
            except:
                continue
        
        # Pattern 3: string.char constructions
        for match in re.finditer(
            r'string\.char\s*\(\s*(\d+(?:\s*,\s*\d+)+)\s*\)', source
        ):
            try:
                bytes_list = [int(n.strip()) & 0xFF for n in match.group(1).split(',')
                            if 32 <= int(n.strip()) <= 126]
                if len(bytes_list) > 2:
                    decoded = bytes(bytes_list).decode('latin-1')
                    constants[f'ch_{restored}'] = decoded
                    restored += 1
            except:
                continue
        
        result.constants_decrypted = restored
        result.constant_map = constants
        return result
    
    @staticmethod
    def _deserialize_generic(result: PipelineResult) -> PipelineResult:
        """Generic heuristic deserialization."""
        source = result.source
        constants = {}
        restored = 0
        
        # Find inline byte arrays
        pattern = re.compile(r'\{\s*(\d{2,3}\s*,\s*){3,}\d{2,3}\s*\}')
        for match in pattern.finditer(source):
            try:
                nums = [int(n) & 0xFF for n in re.findall(r'\d+', match.group(0))
                       if 32 <= int(n) <= 126]
                if len(nums) > 3:
                    decoded = bytes(nums).decode('latin-1')
                    constants[f'gen_{restored}'] = decoded
                    restored += 1
            except:
                continue
        
        result.constants_decrypted = restored
        result.constant_map = constants
        return result


